{#
 # The sign-in pages: a brand panel on wide screens, the form beside it.
 # Pages extend it and fill `title`, `heading`, `lead` and `form`.
 #}
{% extends "base.twig" %}
{% import "macros/ui.twig" as ui %}

{% block body_class %}lp-auth-page{% endblock %}

{% block body %}
<div class="lp-auth">
  <section class="lp-auth__aside" aria-hidden="true">
    <a class="lp-brand lp-brand--light" href="{{ urls.home|default(home|default('/')) }}" tabindex="-1">{{ ui.logo(36) }}<span class="lp-brand__name">LPanel</span></a>
    <div class="lp-auth__pitch">
      <h2>Your servers, under control.</h2>
      <p>Websites, users and servers from one panel, with every change checked and recorded.</p>
      <ul class="lp-auth__points">
        <li>{{ ui.icon('lock') }}<span><strong>Root signs in with the server's own password</strong>, checked by PAM on the server, never stored by the panel.</span></li>
        <li>{{ ui.icon('shield') }}<span><strong>Two-factor sign-in</strong> with any authenticator app, for every account.</span></li>
        <li>{{ ui.icon('activity') }}<span><strong>A complete audit trail</strong> of who did what, and from where.</span></li>
      </ul>
    </div>
    <div class="lp-auth__foot">Sessions end after two idle hours, and after twelve at most.</div>
  </section>

  <section class="lp-auth__main">
    <div class="lp-auth__top">
      <a class="lp-brand d-lg-none" href="{{ urls.home|default(home|default('/')) }}">{{ ui.logo(30) }}<span class="lp-brand__name">LPanel</span></a>
      <button type="button" class="lp-icon-btn ms-auto" data-lp-theme-toggle aria-label="Switch light or dark theme" title="Switch theme">
        <span class="lp-theme-light">{{ ui.icon('moon') }}</span><span class="lp-theme-dark">{{ ui.icon('sun') }}</span>
      </button>
    </div>
    <div class="lp-auth__card">
      {% block icon %}{% endblock %}
      <h1 class="lp-auth__title">{% block heading %}{% endblock %}</h1>
      <p class="lp-auth__lead">{% block lead %}{% endblock %}</p>
      {% if flash|default(null) %}{{ ui.alert(flash.type, flash.message) }}{% endif %}
      {% if error|default(null) %}{{ ui.alert('danger', error) }}{% endif %}
      {% block form %}{% endblock %}
    </div>
    <div class="lp-auth__legal">Protected by a strict content security policy · Unauthorised access is recorded</div>
  </section>
</div>
{% endblock %}
