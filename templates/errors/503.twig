{#
 # Maintenance mode (php laika down), or anything else that answers 503.
 #
 # error.message is the --message given to `down`, when there was one. The
 # Retry-After header is already on the response; this page only has to say
 # what is happening.
 #
 # In scope: `error` (an ErrorDocument), `home`, and `view`.
 #}
{% extends "layout.twig" %}

{% block title %}Down for maintenance{% endblock %}

{% block content %}
<section class="lp-error">
  <p class="lp-error__status">{{ error.status }}</p>
  <h1 class="lp-error__title">Down for maintenance</h1>
  <p class="lp-error__text">{{ error.message != error.title ? error.message : 'The panel is being updated and will be back shortly. Your websites keep running.' }}</p>
</section>
{% endblock %}
