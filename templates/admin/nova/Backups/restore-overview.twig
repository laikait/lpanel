{% extends "layout.twig" %}

{% macro size(b) %}{% if b >= 1073741824 %}{{ (b / 1073741824)|number_format(1) }} GB{% elseif b >= 1048576 %}{{ (b / 1048576)|number_format(1) }} MB{% elseif b >= 1024 %}{{ (b / 1024)|number_format(0) }} KB{% else %}{{ b }} B{% endif %}{% endmacro %}

{% macro state(s) %}{% if s == 'done' %}<span class="badge ok">{{ 'Backups.state_done'|local }}</span>{% elseif s == 'running' or s == 'creating' %}<span class="badge info">{{ 'Backups.state_running'|local }}</span>{% else %}<span class="badge bad">{{ 'Backups.state_failed'|local }}</span>{% endif %}{% endmacro %}

{% block content %}
<div class="page-head">
    <div>
        <a class="back-link" href="{{ backups_url }}">{{ icon('chevron') }}{{ 'Backups.title'|local }}</a>
        <h1>{{ 'Backups.restore_title'|local }}</h1>
        <p>{{ 'Backups.overview_lead'|local }}</p>
    </div>
    {% if destinations|length > 1 %}
    <form class="page-actions restore-dest" method="get" action="{{ page_url }}">
        <label class="sr-only" for="o-dest">{{ 'Backups.destination'|local }}</label>
        <select class="input" id="o-dest" name="destination" onchange="this.form.submit()">
            {% for d in destinations %}<option value="{{ d.id }}"{% if destination and destination.id == d.id %} selected{% endif %}>{{ d.name }}</option>{% endfor %}
        </select>
        <noscript><button class="btn" type="submit">{{ 'Backups.show'|local }}</button></noscript>
    </form>
    {% endif %}
</div>

{% set busy = restores|filter(r => r.state == 'running' or r.state == 'creating') %}
{% if busy is not empty %}<div class="alert alert-info" data-reload="8">{{ icon('refresh') }}<p>{{ 'Backups.overview_busy'|local({n: busy|length}) }}</p></div>{% endif %}

<div class="grid grid-side restore-layout">
    <div class="stack">
        <section class="card">
            <div class="card-head"><div><h2>{{ 'Backups.accounts_there'|local({name: destination ? destination.name : '—'}) }}</h2><p>{{ 'Backups.accounts_there_lead'|local }}</p></div></div>
            {% if destination is null %}
                <div class="empty">{{ icon('archive') }}<h3>{{ 'Backups.restore_none_title'|local }}</h3><p>{{ 'Backups.restore_none_admin'|local }}</p></div>
            {% elseif snapshots_failed %}
                <div class="card-body"><div class="alert alert-error" style="margin:0">{{ icon('alert') }}<p>{{ 'Backups.error_snapshots'|local }}</p></div></div>
            {% elseif accounts is empty %}
                <div class="empty">{{ icon('archive') }}<h3>{{ 'Backups.restore_no_snapshots_title'|local }}</h3><p>{{ 'Backups.overview_empty'|local }}</p></div>
            {% else %}
            <div class="table-wrap"><table class="table">
                <thead><tr>
                    <th>{{ 'Backups.account'|local }}</th>
                    <th>{{ 'Backups.latest'|local }}</th>
                    <th class="hide-sm" style="text-align:end">{{ 'Backups.snapshots'|local }}</th>
                    <th style="text-align:end"><span class="sr-only">{{ 'Backups.actions'|local }}</span></th>
                </tr></thead>
                <tbody>
                {% for a in accounts %}
                    <tr>
                        <td><strong class="mono">{{ a.username }}</strong>
                            <div class="domain-sub">{% if a.here %}<span class="badge ok">{{ 'Backups.on_this_server'|local }}</span>{% elseif a.taken %}<span class="badge plain">{{ 'Backups.name_in_use'|local }}</span>{% else %}<span class="badge warn">{{ 'Backups.not_here'|local }}</span>{% endif %}</div>
                        </td>
                        <td>{{ a.latest.time|date('Y-m-d H:i') }}<div class="domain-sub">{{ _self.size(a.bytes) }}</div></td>
                        <td class="hide-sm" style="text-align:end">{{ a.count }}</td>
                        <td style="text-align:end">
                            {% if a.here %}<a class="btn btn-sm" href="{{ a.restore_url }}">{{ icon('refresh') }}<span class="hide-sm">{{ 'Backups.restore'|local }}</span></a>
                            {% elseif not a.taken %}<a class="btn btn-sm btn-primary" href="{{ a.plan_url }}">{{ icon('plus') }}<span class="hide-sm">{{ 'Backups.make_again'|local }}</span></a>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table></div>
            {% endif %}
        </section>
    </div>

    <div class="stack">
        <section class="card">
            <div class="card-head"><div><h2>{{ 'Backups.recent_restores'|local }}</h2></div></div>
            {% if restores is empty %}
                <div class="card-body"><p class="muted" style="margin:0">{{ 'Backups.no_restores'|local }}</p></div>
            {% else %}
            <ul class="restore-log">
                {% for r in restores %}
                    <li>
                        <div class="restore-log-head">{{ _self.state(r.state) }} <strong class="mono">{{ r.username }}</strong> {{ ('Backups.kind_' ~ r.kind)|local }}<span class="muted">{{ r.created_at|when }}</span></div>
                        {% if r.summary %}<div class="domain-sub mono restore-log-what">{{ r.summary }}</div>{% endif %}
                        {% if r.state == 'failed' %}<div class="domain-sub backup-error">{{ r.error starts with 'Backups.' ? r.error|local : r.error }}</div>{% endif %}
                        {% if r.state == 'done' and r.kind == 'download' %}<div class="domain-sub">{{ 'Backups.download_ready'|local({file: r.result.file}) }}</div>{% endif %}
                        {% if r.by_owner %}<div class="domain-sub">{{ 'Backups.by_owner'|local }}</div>{% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% endif %}
        </section>

        <section class="card">
            <div class="card-head"><div><h2>{{ 'Backups.moving_title'|local }}</h2></div></div>
            <div class="card-body">
                <ul class="ssh-facts">
                    <li>{{ icon('key') }}<span>{{ 'Backups.moving_1'|local }}</span></li>
                    <li>{{ icon('server') }}<span>{{ 'Backups.moving_2'|local }}</span></li>
                    <li>{{ icon('plus') }}<span>{{ 'Backups.moving_3'|local }}</span></li>
                </ul>
            </div>
        </section>
    </div>
</div>
{% endblock %}
