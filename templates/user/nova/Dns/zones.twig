{% extends "layout.twig" %}

{% block content %}
<div class="page-head">
    <div>
        <h1>{{ 'Dns.title'|local }}</h1>
        <p>{{ 'Dns.lead'|local }}</p>
    </div>
</div>

<div class="card">
    {% if zones is empty %}
        <div class="empty">{{ icon('globe') }}<h3>{{ 'Dns.no_zones'|local }}</h3><p>{{ 'Dns.no_zones_user_hint'|local }}</p></div>
    {% else %}
    <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'Dns.zone'|local }}</th><th class="hide-sm">{{ 'Dns.records'|local }}</th><th>{{ 'Dns.delegation'|local }}</th><th style="text-align:end"><span class="sr-only">{{ 'Dns.actions'|local }}</span></th></tr></thead>
        <tbody>
        {% for z in zones %}
            <tr>
                <td>
                    <a class="domain-link" href="{{ z.url }}"><strong class="mono">{{ z.name }}</strong></a>
                    {% if z.state == 'failed' %}<span class="badge bad">{{ 'Dns.state_failed'|local }}</span>{% elseif z.state == 'pending' %}<span class="badge warn">{{ 'Dns.state_pending'|local }}</span>{% endif %}
                </td>
                <td class="hide-sm">{{ z.records }}</td>
                <td>
                    {% if z.delegation == 'ok' %}<span class="badge ok">{{ 'Dns.delegation_ok'|local }}</span>
                    {% elseif z.delegation == 'elsewhere' %}<span class="badge warn">{{ 'Dns.delegation_elsewhere'|local }}</span>
                    {% elseif z.delegation == 'none' %}<span class="badge plain">{{ 'Dns.delegation_none'|local }}</span>
                    {% else %}<span class="muted">—</span>{% endif %}
                </td>
                <td style="text-align:end"><a class="btn btn-sm btn-ghost" href="{{ z.url }}" aria-label="{{ 'Dns.records_of'|local({name: z.name}) }}">{{ icon('settings') }}<span class="hide-sm">{{ 'Dns.edit'|local }}</span></a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% endif %}
</div>
{% endblock %}
