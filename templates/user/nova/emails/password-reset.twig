{#
 # Sent by Auth\PasswordReset. In scope: `link`, `name`, `minutes`.
 # Wrapped in the User panel template's email layout; keep `link`, which is
 # the whole point.
 #}
{% extends "@UserTemplate/emails/base.twig" %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <p style="margin:0 0 14px;">Hello{{ name ? ' ' ~ name : '' }},</p>
    <p style="margin:0 0 22px;">Somebody asked to reset the password for your account. If it was you, choose a new one here:</p>
    <p style="margin:0 0 22px;"><a href="{{ link }}" style="display:inline-block;padding:12px 22px;border-radius:12px;background:#0d9488;color:#ffffff;font-weight:600;text-decoration:none;">Reset your password</a></p>
    <p style="margin:0;color:#46557a;font-size:14px;">The link works once, for {{ minutes }} minutes. If you did not ask, ignore this email: your password has not changed.</p>
{% endblock %}
