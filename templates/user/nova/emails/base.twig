{#
 # nova's email layout (User panel: teal). Emails extend it:
 #   {% extends "@UserTemplate/emails/base.twig" %}
 #   {% block body %}…{% endblock %}
 # Table layout and inline styles only: mail clients ignore stylesheets.
 #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}LPanel{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f3f6fc;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0f1b3a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f6fc;padding:32px 12px;">
<tr><td align="center">
    <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">
        <tr><td style="padding:0 4px 18px;font-size:20px;font-weight:800;letter-spacing:-.02em;color:#0a2c33;">
            <span style="display:inline-block;width:28px;height:28px;line-height:28px;text-align:center;border-radius:8px;background:#0d9488;color:#ffffff;font-size:15px;vertical-align:middle;">L</span>
            <span style="vertical-align:middle;padding-left:8px;">LPanel</span>
        </td></tr>
        <tr><td style="background:#ffffff;border:1px solid #e4e9f3;border-radius:16px;padding:32px 32px 28px;font-size:15px;line-height:1.6;">
            {% block body %}{% endblock %}
        </td></tr>
        <tr><td style="padding:18px 8px 0;font-size:12.5px;color:#7886a6;text-align:center;">
            {% block footer %}This message was sent by LPanel.{% endblock %}
        </td></tr>
    </table>
</td></tr>
</table>
</body>
</html>
