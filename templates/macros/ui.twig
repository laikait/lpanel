<svg class="lp-icon{{ class ? ' ' ~ class : '' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ (paths[name] ?? paths['info'])|raw }}</svg>
{%- endmacro %}

{# The LPanel mark: a rounded tile with a stacked "L" of server layers. #}
{#- The tile's gradient is CSS (.lp-logo), not an SVG <defs>: an id would repeat when the logo appears twice. -#}
{% macro logo(size) %}
<span class="lp-logo" style="width: {{ size|default(32) }}px; height: {{ size|default(32) }}px" aria-hidden="true">
<svg viewBox="0 0 32 32" width="100%" height="100%" focusable="false">
  <rect x="9" y="8" width="4" height="16" rx="1.5" fill="#fff"/>
  <rect x="9" y="20" width="14" height="4" rx="1.5" fill="#fff"/>
  <rect x="16" y="14" width="7" height="3.5" rx="1.5" fill="#fff" opacity=".55"/>
</svg>
</span>
{%- endmacro %}

{% macro csrf(token) %}<input type="hidden" name="_token" value="{{ token }}">{% endmacro %}

{# Initials on a colour picked from the name, so the same person always looks the same. #}
{% macro avatar(name, initials, size) %}
{%- set letters = initials ?: (name|default('?')|slice(0, 1)|upper) -%}
<span class="lp-avatar lp-avatar--{{ (name|default('')|length) % 6 }}{{ size ? ' lp-avatar--' ~ size : '' }}" aria-hidden="true">{{ letters }}</span>
{%- endmacro %}

{# A UTC timestamp from the database; app.js shows it in the viewer's time and as "3 min ago". #}
{% macro time(value, empty) %}
{%- if value -%}
<time datetime="{{ value|date('Y-m-d\\TH:i:s\\Z') }}" data-lp-time title="{{ value|date('d M Y, H:i:s') }} UTC">{{ value|date('d M Y, H:i') }} UTC</time>
{%- else -%}
<span class="text-body-tertiary">{{ empty|default('Never') }}</span>
{%- endif -%}
{%- endmacro %}

{% macro role_badge(role) %}
{%- set styles = {'root': ['danger', 'crown', 'root'], 'admin': ['primary', 'shield', 'Administrator'], 'customer': ['success', 'user', 'Customer']} -%}
{%- set s = styles[role] ?? ['secondary', 'user', role] -%}
<span class="lp-badge lp-badge--{{ s[0] }}">{{ _self.icon(s[1]) }}{{ s[2] }}</span>
{%- endmacro %}

{% macro status_badge(status) %}
{%- if status == 'active' -%}<span class="lp-badge lp-badge--success lp-badge--dot">Active</span>
{%- elseif status == 'suspended' -%}<span class="lp-badge lp-badge--warning lp-badge--dot">Suspended</span>
{%- elseif status == 'expired' -%}<span class="lp-badge lp-badge--secondary lp-badge--dot">Expired</span>
{%- elseif status == 'revoked' -%}<span class="lp-badge lp-badge--danger lp-badge--dot">Revoked</span>
{%- elseif status == 'online' -%}<span class="lp-badge lp-badge--success lp-badge--dot lp-badge--pulse">Online</span>
{%- elseif status == 'offline' -%}<span class="lp-badge lp-badge--danger lp-badge--dot">Offline</span>
{%- elseif status == 'pending' -%}<span class="lp-badge lp-badge--warning lp-badge--dot">Waiting for agent</span>
{#- hosting accounts -#}
{%- elseif status == 'provisioning' -%}<span class="lp-badge lp-badge--info lp-badge--dot lp-badge--pulse">Setting up</span>
{%- elseif status == 'updating' -%}<span class="lp-badge lp-badge--info lp-badge--dot lp-badge--pulse">Applying</span>
{%- elseif status == 'suspending' -%}<span class="lp-badge lp-badge--warning lp-badge--dot lp-badge--pulse">Suspending</span>
{%- elseif status == 'resuming' -%}<span class="lp-badge lp-badge--info lp-badge--dot lp-badge--pulse">Unsuspending</span>
{%- elseif status == 'deleting' -%}<span class="lp-badge lp-badge--danger lp-badge--dot lp-badge--pulse">Deleting</span>
{%- elseif status == 'deleted' -%}<span class="lp-badge lp-badge--secondary">{{ _self.icon('trash') }}Deleted</span>
{%- elseif status == 'rotating' -%}<span class="lp-badge lp-badge--info lp-badge--dot">Rotating out</span>
{#- operations -#}
{%- elseif status == 'queued' -%}<span class="lp-badge lp-badge--secondary lp-badge--dot lp-badge--pulse">Queued</span>
{%- elseif status == 'claimed' -%}<span class="lp-badge lp-badge--info lp-badge--dot lp-badge--pulse">Sent to agent</span>
{%- elseif status == 'running' -%}<span class="lp-badge lp-badge--info lp-badge--dot lp-badge--pulse">Running</span>
{%- elseif status == 'succeeded' -%}<span class="lp-badge lp-badge--success">{{ _self.icon('check') }}Succeeded</span>
{%- elseif status == 'failed' -%}<span class="lp-badge lp-badge--danger">{{ _self.icon('x') }}Failed</span>
{%- elseif status == 'cancelled' -%}<span class="lp-badge lp-badge--secondary">{{ _self.icon('ban') }}Cancelled</span>
{%- elseif status == 'needs_attention' -%}<span class="lp-badge lp-badge--warning">{{ _self.icon('alert') }}Needs attention</span>
{%- else -%}<span class="lp-badge lp-badge--secondary lp-badge--dot">{{ status|capitalize }}</span>
{%- endif -%}
{%- endmacro %}

{% macro outcome_badge(outcome) %}
{%- set colors = {'succeeded': 'success', 'allowed': 'info', 'denied': 'danger', 'failed': 'warning'} -%}
<span class="lp-badge lp-badge--{{ colors[outcome] ?? 'secondary' }}">{{ outcome|capitalize }}</span>
{%- endmacro %}

{# A page title row: title, a line under it, and actions on the right. #}
{% macro page_header(title, subtitle, eyebrow) %}
<div class="lp-page-header">
  <div>
    {% if eyebrow %}<div class="lp-eyebrow">{{ eyebrow }}</div>{% endif %}
    <h1 class="lp-page-title">{{ title }}</h1>
    {% if subtitle %}<p class="lp-page-subtitle">{{ subtitle }}</p>{% endif %}
  </div>
</div>
{%- endmacro %}

{% macro empty(icon, title, text) %}
<div class="lp-empty">
  <span class="lp-empty__icon">{{ _self.icon(icon) }}</span>
  <h3 class="lp-empty__title">{{ title }}</h3>
  {% if text %}<p class="lp-empty__text">{{ text }}</p>{% endif %}
</div>
{%- endmacro %}

{% macro alert(type, message) %}
{%- set icons = {'success': 'check-circle', 'danger': 'alert', 'warning': 'alert', 'info': 'info'} -%}
<div class="alert lp-alert alert-{{ type }}" role="{{ type == 'danger' ? 'alert' : 'status' }}">
  {{ _self.icon(icons[type] ?? 'info') }}<div>{{ message }}</div>
</div>
{%- endmacro %}

{# A password input with a show/hide button (app.js). #}
{% macro password(name, id, label, autocomplete, minlength, autofocus, invalid) %}
<label class="form-label" for="{{ id }}">{{ label }}</label>
<div class="lp-password">
  <input class="form-control{{ invalid ? ' is-invalid' : '' }}" id="{{ id }}" name="{{ name }}" type="password" autocomplete="{{ autocomplete }}" maxlength="1024" required{% if minlength %} minlength="{{ minlength }}"{% endif %}{% if autofocus %} autofocus{% endif %}>
  <button class="lp-password__toggle" type="button" data-lp-reveal="{{ id }}" aria-label="Show password" title="Show password">{{ _self.icon('eye') }}</button>
</div>
{%- endmacro %}
