{#
 # LPanel's UI building blocks. Import where needed:
 #
 #     {% import "macros/ui.twig" as ui %}
 #     {{ ui.icon('users') }}  {{ ui.csrf(token) }}  {{ ui.time(user.lastLoginAt) }}
 #
 # Icons are inline SVG drawn for LPanel (24px grid, 1.75 stroke): no icon
 # font, no CDN, nothing the CSP has to allow.
 #}

