{#
 # Sent by Auth\PasswordReset. In scope: `link`, `name`, `minutes`.
 # Email clients ignore stylesheets, so the styles are inline and the layout is a table.
 #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Reset your LPanel password</title>
</head>
<body style="margin:0; padding:0; background:#f4f6fb; font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#0f172a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6fb; padding:32px 12px;">
  <tr><td align="center">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;">
      <tr><td style="padding:0 4px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0"><tr>
          <td style="width:32px; height:32px; border-radius:8px; background:#6366f1; color:#ffffff; font-weight:800; font-size:16px; text-align:center; line-height:32px;">L</td>
          <td style="padding-left:10px; font-weight:750; font-size:18px; letter-spacing:-0.02em; color:#0f172a;">LPanel</td>
        </tr></table>
      </td></tr>
      <tr><td style="background:#ffffff; border:1px solid #e3e8f0; border-radius:14px; padding:32px 32px 28px;">
        <h1 style="margin:0 0 12px; font-size:22px; line-height:1.3; letter-spacing:-0.02em; color:#0f172a;">Reset your password</h1>
        <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">Hello{{ name ? ' ' ~ name : '' }},</p>
        <p style="margin:0 0 24px; font-size:15px; line-height:1.6; color:#334155;">Someone asked to reset the password for your LPanel account. If it was you, choose a new one:</p>
        <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px;"><tr>
          <td style="border-radius:9px; background:#4f46e5;"><a href="{{ link }}" style="display:inline-block; padding:12px 22px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:9px;">Choose a new password</a></td>
        </tr></table>
        <p style="margin:0 0 8px; font-size:13px; line-height:1.6; color:#64748b;">The link works once, for {{ minutes }} minutes, and signs out every session on your account. If the button does not work, paste this into your browser:</p>
        <p style="margin:0 0 24px; font-size:12px; line-height:1.5; word-break:break-all;"><a href="{{ link }}" style="color:#4f46e5;">{{ link }}</a></p>
        <p style="margin:0; padding-top:20px; border-top:1px solid #e3e8f0; font-size:13px; line-height:1.6; color:#64748b;">Didn't ask? Ignore this email: your password has not changed. If it keeps happening, tell your administrator.</p>
      </td></tr>
      <tr><td style="padding:18px 4px 0; font-size:12px; color:#94a3b8; text-align:center;">Sent by LPanel. Never share this link.</td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
