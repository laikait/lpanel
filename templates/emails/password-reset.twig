{#
 # Sent by Auth\PasswordReset. In scope: `link`, `name`, `minutes`.
 # Replace it to match the application; keep `link`, which is the whole point.
 #}
<!doctype html>
<html>
<body style="font-family: system-ui, sans-serif; line-height: 1.5; color: #1a1a1a;">
    <p>Hello{{ name ? ' ' ~ name : '' }},</p>
    <p>Somebody asked to reset the password for your account. If it was you, choose a new one here:</p>
    <p><a href="{{ link }}">Reset your password</a></p>
    <p>The link works once, for {{ minutes }} minutes. If you did not ask, ignore this email: your password has not changed.</p>
</body>
</html>
