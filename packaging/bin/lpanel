#!/bin/sh
# lpanel: the panel's console (php laika), run as the panel's own user.
#
#   sudo lpanel servers:add web-01
#   sudo lpanel operations:run web-01 system.metrics --wait
#   sudo lpanel migrate      (as lpanel_migrate, the one account that may change tables)
#
# To change the host name or ports, edit /etc/lpanel/lpanel.conf and run
# lpanel-setup instead.
set -eu

[ "$(id -u)" -eq 0 ] || { echo "lpanel: run it as root: sudo lpanel $*" >&2; exit 1; }
cd /opt/lpanel

run() { runuser -u lpanel -- /usr/bin/php /opt/lpanel/laika "$@"; }

case "${1:-}" in
migrate | migrate:rollback)
	# The cached configuration holds the application's account; without it,
	# the migration account given here is the one used.
	run cache:clear >/dev/null
	status=0
	(
		set -a
		. /etc/lpanel/migrate.env
		set +a
		run "$@"
	) || status=$?
	run cache:warm >/dev/null
	exit $status
	;;
esac

exec runuser -u lpanel -- /usr/bin/php /opt/lpanel/laika "$@"
