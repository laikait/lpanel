#!/bin/bash
# lpanel-setup: make this machine a working LPanel host, and keep it one.
#
# The package runs it on every install and upgrade; run it again by hand (as
# root) after changing /etc/lpanel/lpanel.conf. What it makes -- users, keys,
# certificates, passwords, the database -- it makes once and never replaces.
# What it renders -- the Nginx and PHP-FPM configuration -- it renders every
# time, from /usr/share/lpanel.
set -euo pipefail
umask 022

APP=/opt/lpanel
ETC=/etc/lpanel
DATA=/var/lib/lpanel
LOGDIR=/var/log/lpanel
SHARE=/usr/share/lpanel
LIB=/usr/lib/lpanel
PHP=/usr/bin/php

log() { echo "lpanel-setup: $*"; }
die() { echo "lpanel-setup: $*" >&2; exit 1; }
has_systemd() { [ -d /run/systemd/system ]; }

[ "$(id -u)" = 0 ] || die "run it as root"
[ -f "$APP/laika" ] || die "$APP is not an LPanel installation"

# ---- settings, made once and the administrator's to change -----------------

install -d -m 0755 "$ETC"
if [ ! -f "$ETC/lpanel.conf" ]; then
	cat > "$ETC/lpanel.conf" <<EOF
# LPanel host settings. After changing them, run: lpanel-setup
#
# The name people and agents reach this panel by. Agent pairing commands and
# links in emails are built from it.
PANEL_HOST=$(hostname -f 2>/dev/null || hostname)
# Browsers (screens and API) connect here; agents connect to AGENT_PORT.
PANEL_PORT=8443
AGENT_PORT=8444
EOF
	log "wrote $ETC/lpanel.conf"
fi
# shellcheck source=/dev/null
. "$ETC/lpanel.conf"
[[ ${PANEL_HOST:-} =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || die "PANEL_HOST in $ETC/lpanel.conf is not a host name: ${PANEL_HOST:-}"
for p in "${PANEL_PORT:-}" "${AGENT_PORT:-}"; do
	[[ $p =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || die "ports in $ETC/lpanel.conf must be 1-65535, got '$p'"
done
[ "$PANEL_PORT" != "$AGENT_PORT" ] || die "PANEL_PORT and AGENT_PORT must differ"

# A port another program holds is not taken over (ADR-0003). One the panel's
# own Nginx already listens on is fine.
ours() { [ -f /run/lpanel-nginx.pid ] && ss -Hltnp "( sport = :$1 )" 2>/dev/null | grep -q "pid=$(cat /run/lpanel-nginx.pid),"; }
for p in "$PANEL_PORT" "$AGENT_PORT"; do
	if ss -Hltn "( sport = :$p )" 2>/dev/null | grep -q . && ! ours "$p"; then
		die "port $p is in use: $(ss -Hltnp "( sport = :$p )" | head -1). Choose another in $ETC/lpanel.conf."
	fi
done

# ---- users and directories ----------------------------------------------------

getent group lpanel-web >/dev/null || groupadd --system lpanel-web
getent passwd lpanel-web >/dev/null || useradd --system --gid lpanel-web --no-create-home --home-dir /nonexistent \
	--shell /usr/sbin/nologin --comment "LPanel web server workers" lpanel-web
getent passwd lpanel >/dev/null || useradd --system --user-group --no-create-home --home-dir "$DATA" \
	--shell /usr/sbin/nologin --comment "LPanel" lpanel
usermod -a -G lpanel-web lpanel

# The application's writable state (/opt/lpanel/system is a link to it).
install -d -m 0750 -o lpanel -g lpanel "$DATA"
for d in Backups Cache Keys Logs Runtime Schedule Security Sessions Storage; do
	install -d -m 0750 -o lpanel -g lpanel "$DATA/$d"
done
install -d -m 0755 "$LOGDIR"
install -d -m 0750 -o root -g adm "$LOGDIR/nginx"
install -d -m 0750 -o lpanel -g adm "$LOGDIR/php"
install -d -m 0700 -o lpanel-web -g lpanel-web /var/cache/lpanel-nginx
install -d -m 0755 "$ETC/nginx" "$ETC/tls"
install -d -m 0750 -o root -g lpanel "$ETC/keys"

# ---- PHP ----------------------------------------------------------------------

PHPV=$($PHP -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;')
[ -x "/usr/sbin/php-fpm$PHPV" ] || die "php$PHPV-fpm is not installed"
missing=$(for ext in intl mbstring pdo_mysql sodium openssl; do $PHP -m | grep -qix "$ext" || echo "$ext"; done)
[ -z "$missing" ] || die "PHP $PHPV lacks: $(echo $missing)"
install -d -m 0755 "$LIB"
ln -sfn "/usr/sbin/php-fpm$PHPV" "$LIB/php-fpm"

# ---- TLS: two certificates, made once ----------------------------------------------

# make_cert <name> <days> <subjectAltName>
make_cert() {
	[ -f "$ETC/tls/$1.key" ] && return 0
	openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days "$2" \
		-subj "/CN=$PANEL_HOST" -addext "subjectAltName=$3" \
		-keyout "$ETC/tls/$1.key" -out "$ETC/tls/$1.crt" 2>/dev/null
	chmod 0600 "$ETC/tls/$1.key"
	chmod 0644 "$ETC/tls/$1.crt"
	log "made the $1 certificate"
}
# Agents pin this key: it is never replaced, so it does not need to expire soon.
make_cert agent 3650 "DNS:$PANEL_HOST"
# Browsers: self-signed to start with. Replace panel.crt and panel.key with a
# real certificate whenever you like; agents do not use it.
make_cert panel 825 "DNS:$PANEL_HOST,DNS:localhost,IP:127.0.0.1"
PIN="sha256/$(openssl x509 -in "$ETC/tls/agent.crt" -pubkey -noout | openssl pkey -pubin -outform der \
	| openssl dgst -sha256 -binary | base64 | tr '+/' '-_' | tr -d '=')"

# ---- secrets, made once ------------------------------------------------------------

# 160 bits, in characters that need no quoting in SQL or in the env file.
secret() { openssl rand -hex 20; }

if [ ! -f "$ETC/lpanel.env" ]; then
	(
		umask 027
		cat > "$ETC/lpanel.env" <<EOF
# The panel's environment. Secrets: 0640 root:lpanel. Lines marked "managed"
# are rewritten by lpanel-setup from lpanel.conf; after changing any other
# line, run: lpanel cache:warm
APP_ENV=production
APP_DEBUG=0
APP_KEY=$(cd "$APP" && $PHP -r 'require "vendor/autoload.php"; echo App\Engine\Security\Signer::generate();')
APP_URL=
DB_DSN=mysql:unix_socket=/run/mysqld/mysqld.sock;dbname=lpanel;charset=utf8mb4
DB_USERNAME=lpanel_app
DB_PASSWORD=$(secret)
LPANEL_ROOT_VERIFIER=authd
LPANEL_AUTHD_SOCKET=/run/lpanel-authd/authd.sock
LPANEL_AGENT_URL=
LPANEL_TLS_CERTIFICATE=$ETC/tls/agent.crt
LPANEL_OPERATION_KEY=$ETC/keys/operations.key
LOG_WRITERS=file
# Password-reset emails. Until a mail server is set (MAIL_TRANSPORT=smtp,
# MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD), they go to the log.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=lpanel@$PANEL_HOST
MAIL_FROM_NAME=LPanel
EOF
	)
	chown root:lpanel "$ETC/lpanel.env"
	log "wrote $ETC/lpanel.env"
fi
if [ ! -f "$ETC/migrate.env" ]; then
	( umask 077; printf 'DB_USERNAME=lpanel_migrate\nDB_PASSWORD=%s\n' "$(secret)" > "$ETC/migrate.env" )
	log "wrote $ETC/migrate.env"
fi

# set_env <key> <value>: a managed line of lpanel.env.
set_env() {
	if grep -q "^$1=" "$ETC/lpanel.env"; then
		sed -i "s|^$1=.*|$1=$2|" "$ETC/lpanel.env"
	else
		echo "$1=$2" >> "$ETC/lpanel.env"
	fi
}
set_env APP_URL "https://$PANEL_HOST:$PANEL_PORT"
set_env LPANEL_AGENT_URL "https://$PANEL_HOST:$AGENT_PORT"

# The operation-signing key (AGENT_PROTOCOL.md §1): a 32-byte Ed25519 seed,
# base64url. Every paired agent trusts it, so it is never replaced.
if [ ! -f "$ETC/keys/operations.key" ]; then
	( umask 027; $PHP -r 'echo rtrim(strtr(base64_encode(random_bytes(32)), "+/", "-_"), "="), "\n";' > "$ETC/keys/operations.key" )
	chown root:lpanel "$ETC/keys/operations.key"
	chmod 0640 "$ETC/keys/operations.key"
	log "made the operation-signing key"
fi

# ---- the database (ADR-0008) --------------------------------------------------------

if has_systemd; then
	systemctl enable --now mariadb.service >/dev/null 2>&1 || systemctl start mariadb.service
fi
for _ in $(seq 1 30); do mariadb -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done
mariadb -e 'SELECT 1' >/dev/null || die "cannot reach MariaDB as root through its socket"

env_value() { sed -n "s/^$2=//p" "$1" | tail -1; }
APP_PW=$(env_value "$ETC/lpanel.env" DB_PASSWORD)
MIG_PW=$(env_value "$ETC/migrate.env" DB_PASSWORD)
# On stdin, never on a command line. The application's account changes rows,
# never tables; only the migration account does that.
mariadb <<SQL
CREATE DATABASE IF NOT EXISTS lpanel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'lpanel_app'@'localhost' IDENTIFIED BY '$APP_PW';
ALTER USER 'lpanel_app'@'localhost' IDENTIFIED BY '$APP_PW';
GRANT SELECT, INSERT, UPDATE, DELETE ON lpanel.* TO 'lpanel_app'@'localhost';
CREATE USER IF NOT EXISTS 'lpanel_migrate'@'localhost' IDENTIFIED BY '$MIG_PW';
ALTER USER 'lpanel_migrate'@'localhost' IDENTIFIED BY '$MIG_PW';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON lpanel.* TO 'lpanel_migrate'@'localhost';
SQL
unset APP_PW MIG_PW

# ---- rendered configuration -----------------------------------------------------------

NGINX_VERSION=$(nginx -v 2>&1 | sed -n 's|.*nginx/\([0-9.]*\).*|\1|p')
if [ "$(printf '%s\n1.25.1\n' "$NGINX_VERSION" | sort -V | head -1)" = 1.25.1 ]; then
	HTTP2_LISTEN="" HTTP2_ON="        http2 on;"
else
	HTTP2_LISTEN=" http2" HTTP2_ON=""
fi
LISTEN6_PANEL="" LISTEN6_AGENT=""
if [ -f /proc/net/if_inet6 ]; then
	LISTEN6_PANEL="        listen [::]:$PANEL_PORT ssl$HTTP2_LISTEN;"
	LISTEN6_AGENT="        listen [::]:$AGENT_PORT ssl;"
fi

sed -e "s|@PANEL_PORT@|$PANEL_PORT|g" -e "s|@AGENT_PORT@|$AGENT_PORT|g" \
	-e "s|@HTTP2_LISTEN@|$HTTP2_LISTEN|g" -e "s|^@HTTP2_ON@$|$HTTP2_ON|" \
	-e "s|^@LISTEN6_PANEL@$|$LISTEN6_PANEL|" -e "s|^@LISTEN6_AGENT@$|$LISTEN6_AGENT|" \
	"$SHARE/nginx.conf.in" > "$ETC/nginx/nginx.conf.new"
nginx -t -q -c "$ETC/nginx/nginx.conf.new" || die "the rendered Nginx configuration does not pass nginx -t; $ETC/nginx/nginx.conf is unchanged"
mv "$ETC/nginx/nginx.conf.new" "$ETC/nginx/nginx.conf"
install -m 0644 "$SHARE/php-fpm.conf.in" "$ETC/php-fpm.conf"

# ---- the application: migrate, then cache ---------------------------------------------

app() { (cd "$APP" && runuser -u lpanel -- "$PHP" "$APP/laika" "$@"); }

# The cached configuration holds the application's credentials, so it is
# cleared first: migrations run with the migration account's, given only to
# this one command.
app cache:clear >/dev/null
( set -a; . "$ETC/migrate.env"; set +a; app migrate ) || die "migrations failed; the panel is left as it was"
app cache:warm >/dev/null
if [ -f "$DATA/Runtime/lpanel-upgrading" ]; then
	app up >/dev/null
	rm -f "$DATA/Runtime/lpanel-upgrading"
fi

# ---- services ---------------------------------------------------------------------------

if has_systemd; then
	systemctl daemon-reload
	systemctl enable lpanel-php-fpm.service lpanel-nginx.service lpanel-authd.socket lpanel-scheduler.timer >/dev/null 2>&1
	# New code: a fresh PHP (OPcache) and a fresh authd binary.
	systemctl restart lpanel-php-fpm.service
	systemctl try-restart lpanel-authd.service
	systemctl start lpanel-authd.socket
	if systemctl is-active --quiet lpanel-nginx.service; then
		systemctl reload lpanel-nginx.service
	else
		systemctl start lpanel-nginx.service
	fi
	systemctl start lpanel-scheduler.timer
fi

cat <<EOF

LPanel is at https://$PANEL_HOST:$PANEL_PORT/
  Sign in as root with this server's root password.
  The certificate is self-signed until you replace $ETC/tls/panel.crt and panel.key.
Agents pair with port $AGENT_PORT and pin $PIN
  (in the panel: Servers -> Add server shows the command).
EOF
