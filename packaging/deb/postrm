#!/bin/sh
set -e

case "$1" in
remove)
	[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
	# Linked by lpanel-setup, not shipped.
	rm -f /usr/lib/lpanel/php-fpm
	;;
purge)
	# Settings, keys, certificates, application state and logs. Every paired
	# agent trusted /etc/lpanel/keys and /etc/lpanel/tls/agent.*: after a purge
	# they must all be paired again.
	rm -rf /etc/lpanel /var/lib/lpanel /var/log/lpanel /var/cache/lpanel-nginx
	rm -f /usr/lib/lpanel/php-fpm
	# The database is data, not configuration: it is kept.
	echo "lpanel: the MariaDB database 'lpanel' and its accounts lpanel_app and lpanel_migrate are kept."
	echo "lpanel: to remove them too: mariadb -e \"DROP DATABASE lpanel; DROP USER 'lpanel_app'@'localhost', 'lpanel_migrate'@'localhost';\""
	;;
esac

exit 0
