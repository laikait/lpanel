/var/log/lpanel/nginx/*.log {
	daily
	rotate 14
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		[ -f /run/lpanel-nginx.pid ] && kill -USR1 "$(cat /run/lpanel-nginx.pid)" || true
	endscript
}

/var/log/lpanel/php/*.log {
	weekly
	rotate 8
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	su lpanel adm
}
