[Unit]
Description=LPanel PHP: the panel's own PHP-FPM master (ADR-0012)
Documentation=file:///usr/share/doc/lpanel/README
After=network.target mariadb.service
Wants=mariadb.service

[Service]
# The distro's php-fpm binary (linked by lpanel-setup) with the panel's own
# configuration. Customer pools live in the distro's php-fpm, so reloading or
# breaking them never reaches the panel.
Type=notify
User=lpanel
Group=lpanel
# To hand its socket to panel Nginx's workers, and nobody else.
SupplementaryGroups=lpanel-web
RuntimeDirectory=lpanel-php-fpm
# Traversable, so panel Nginx reaches the socket; the socket itself is 0660 lpanel:lpanel-web.
RuntimeDirectoryMode=0755
ExecStartPre=/usr/lib/lpanel/php-fpm --test --fpm-config /etc/lpanel/php-fpm.conf
ExecStart=/usr/lib/lpanel/php-fpm --nodaemonize --fpm-config /etc/lpanel/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/lpanel /var/log/lpanel/php
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
