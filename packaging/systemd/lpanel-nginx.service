[Unit]
Description=LPanel web server: the panel's own Nginx (ADR-0003)
Documentation=file:///usr/share/doc/lpanel/README
After=network-online.target lpanel-php-fpm.service
Wants=network-online.target lpanel-php-fpm.service

[Service]
# The distro's nginx binary with the panel's own configuration, pid and logs:
# the hosting Nginx can be reloaded, broken or stopped without touching this.
Type=forking
PIDFile=/run/lpanel-nginx.pid
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/lpanel/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/lpanel/nginx/nginx.conf
ExecReload=/usr/sbin/nginx -t -q -c /etc/lpanel/nginx/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/lpanel-nginx.pid
TimeoutStopSec=5
KillMode=mixed
Restart=on-failure
RestartSec=5s
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
