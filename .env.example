# Every environment variable this framework reads, with the value it assumes
# when the variable is not set.
#
# Copy to .env for a machine that has no real environment to speak of -- a
# laptop, a CI container. A real environment variable always beats this file,
# so a .env left behind on a server cannot override what the deployment set.
#
# This is not the main way to configure an application. Files in config/ are,
# and they may read any of these themselves through App\Engine\Config\Env.
# Every variable and config key, with its default, is listed in
# docs/reference/defaults.md.
#
# Values are text. true/false, yes/no, on/off and 1/0 are all booleans; an empty
# value counts as not set; anything else in a boolean or a number stops the boot
# and says which variable it was.

# --- application ------------------------------------------------------------

# Free-form, and yours to branch on. "production" is assumed.
APP_ENV=production

# Stack traces and messages in responses. Never true in production.
APP_DEBUG=false

# With APP_DEBUG on, errors render as a Whoops page (filp/whoops is installed
# with the framework). This makes its file paths open in an editor; a name
# Whoops does not know is reported on the plain page shown in its place:
# phpstorm, vscode, sublime, atom, emacs, macvim, idea, netbeans, xdebug.
# APP_EDITOR=

# An identifier from timezone_identifiers_list(). Set it deliberately: PHP
# otherwise uses whatever php.ini says, which differs between a laptop and the
# server, and a billing period that changes shape depending on where the code
# runs is a bug found at month end.
APP_TIMEZONE=UTC

# PHP's memory_limit, in PHP's notation: 256M, 1G, or -1 for none. Unset keeps
# whatever php.ini says. A value PHP would not understand stops the boot, and so
# does one below what the process already uses.
# MEMORY_LIMIT=256M

# How long a web request may run, in seconds; 0 means no limit. Unset keeps
# php.ini's max_execution_time. Web requests only: console commands keep no
# limit, and a queue worker limits each job with QUEUE_TIMEOUT.
# MAX_EXECUTION_TIME=30

# The public address, with a subdirectory if there is one. Links that leave the
# page -- a password reset email, an OAuth callback -- are built from it, never
# from the Host header, which the client chooses.
# APP_URL=https://example.com

# --- security ---------------------------------------------------------------

# The one secret the framework itself needs. Generate one with:
#
#     php laika security:key
#
# Without it CSRF tokens are unsigned. They still work -- a token in a cookie
# that has to be echoed back is still something another site cannot read -- but
# the application can no longer tell its own tokens from anybody else's. What
# stops a sibling subdomain planting a token is the __Host-XSRF-TOKEN cookie
# name used over HTTPS, not the key. "php laika security:check" says which mode is
# running. Changing this invalidates every issued token, which logs nobody out
# today and will in a later phase.
# APP_KEY=

# Keys APP_KEY replaced, comma separated, in the same form. Encrypter still
# decrypts what they sealed and never encrypts with them; re-encrypt, then
# remove each. "php laika security:check" warns while one is set.
# APP_PREVIOUS_KEYS=

# Turn CSRF off only for an application with no browser clients at all. Every
# unsafe method is checked unless its route says meta(['csrf' => false]).
CSRF_ENABLED=true

# Bodies larger than this are refused with 413 before anything reads them.
# 8388608 is 8 MiB. php.ini post_max_size is a separate, lower ceiling that PHP
# enforces by silently discarding the body -- the framework detects that case
# and says so rather than letting it look like a validation error.
MAX_REQUEST_BYTES=8388608

# --- localization -----------------------------------------------------------

# The header a trusted CDN or reverse proxy puts the visitor's country in, such
# as CF-IPCountry. It is read only when the request arrives from one of
# http.trusted_proxies, so a client cannot choose its own country. Unset means
# no country detection: the language cookie, then Accept-Language, then en.
# LOCALIZATION_COUNTRY_HEADER=

# A local MaxMind database (GeoLite2-Country.mmdb or GeoLite2-City.mmdb, or the
# paid GeoIP2 ones), relative to the project root or absolute. Looked up on this
# machine, never over the network, and only after the header above. The reader
# (maxmind-db/reader) is installed with the framework. Unset means no lookup.
# LOCALIZATION_MAXMIND_DATABASE=

# --- database ---------------------------------------------------------------

# The single-database case, configured with no file at all. More than one
# connection, or anything with options, goes in config/database.php.
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=erp;charset=utf8mb4
# DB_USERNAME=erp
# DB_PASSWORD=
# DB_CONNECTION=default

# --- cache ------------------------------------------------------------------

# array, file, database or null. "array" lives for one process, which is real
# but does not cross requests; "file" writes under system/Cache/data; "database"
# keeps entries in a table every machine shares; "null" disables caching
# entirely, which is what somebody chasing a stale value wants.
CACHE_STORE=array

# For the database store. Empty means the default connection. `php laika
# migrate` creates the table while CACHE_STORE is database.
# CACHE_CONNECTION=

# Seconds an entry lives when whoever cached it did not say. A caller that
# passes its own TTL always wins.
CACHE_TTL=3600

# --- queue ------------------------------------------------------------------

# sync, file, database or memory. "sync" runs a job where it is dispatched,
# which is the default and needs no worker; "file" writes jobs under
# system/Queue and "database" into a table any machine's worker can take them
# from, and both need "php laika queue:work" running; "memory" lasts for one
# process and is for tests and one-off batch commands.
QUEUE_STORE=sync

# For the database store. Empty means the default connection. `php laika
# migrate` creates the table while QUEUE_STORE is database.
# QUEUE_CONNECTION=

# The queue a job goes on when it does not say.
QUEUE_NAME=default

# How many attempts a job gets, and how long it may hold its reservation.
QUEUE_TRIES=3
QUEUE_TIMEOUT=60

# A worker stops, between jobs, once it uses this much memory: 128M, 1G. Unset
# means 80% of MEMORY_LIMIT when there is one, so a worker exits cleanly and
# its supervisor starts a fresh one instead of PHP killing it mid-job.
# QUEUE_MAX_MEMORY=128M

# --- mail -------------------------------------------------------------------

# log writes each message to the "mail" log channel and sends nothing -- the
# default, so a development machine never mails a customer. smtp or sendmail
# to send for real; "php laika security:check" warns about log in production.
MAIL_TRANSPORT=log

# The From of a message that does not set one.
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME=

# For MAIL_TRANSPORT=smtp. MAIL_ENCRYPTION is tls (STARTTLS, usually port 587),
# ssl (port 465) or none (only for a relay on this machine).
# MAIL_HOST=127.0.0.1
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- storage ----------------------------------------------------------------

# The disk $storage->disk() means without a name: local (system/Storage) or s3.
STORAGE_DISK=local

# The "s3" disk: AWS S3 or anything that speaks its API -- Cloudflare R2,
# DigitalOcean Spaces, Backblaze B2, MinIO. Leave S3_ENDPOINT empty for AWS.
# S3_PATH_STYLE=true puts the bucket in the path, which MinIO and most
# self-hosted servers want. S3_URL is a public base URL (a CDN) for url().
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_KEY=
# S3_SECRET=
# S3_ENDPOINT=
# S3_PATH_STYLE=false
# S3_URL=

# --- session ----------------------------------------------------------------

# file, database or memory. Memory is for tests only: a web request is a process
# that ends, so a session kept in its memory is gone before the response is.
# Use database when more than one machine serves this application -- a file
# store is correct and only works on one of them.
SESSION_STORE=file

# For the database store. Empty means the default connection. `php laika
# migrate` creates the table while SESSION_STORE is database; nothing creates it
# on a request, because an application account should not be able to.
# SESSION_CONNECTION=

# Seconds of inactivity before a session is gone. This is the clock users feel,
# so it is the one worth arguing about.
SESSION_IDLE=7200

# A hard ceiling regardless of activity. Zero means none, which is the default:
# without it, a session a background request keeps warm never expires at all.
# Set it to something a login should never outlive.
SESSION_ABSOLUTE=0

# How long a regenerated session id keeps working. Logging in changes the id,
# and a page usually has other requests already on the wire holding the old one;
# this is how long they have to follow it rather than being logged out by the
# act of logging in.
SESSION_GRACE=30

# The cookie's name.
SESSION_COOKIE=session

# Zero means the cookie goes when the browser does, which is the safer default.
# Outliving the browser is a "remember me", and that is a decision about
# identity rather than about storage.
SESSION_COOKIE_LIFETIME=0

# Require HTTPS for the session cookie. Unset means "follow the request", so
# development over plain HTTP works and HTTPS gets a Secure cookie without
# anybody remembering. Set it on a site that is only ever served over HTTPS.
# SESSION_COOKIE_SECURE=true

# --- scheduler --------------------------------------------------------------

# The clock scheduled tasks are read against. Unset means APP_TIMEZONE. Worth
# setting to UTC on its own even when the application runs local: a wall clock
# repeats an hour every autumn and skips one every spring, so a task that must
# run exactly once and never twice should not be read against one.
# SCHEDULER_TIMEZONE=UTC

# How long a schedule's lock survives the process that took it. It exists
# because a process killed outright releases nothing, so a crash has to cost a
# bounded number of skipped runs rather than a task that never runs again. Set
# it a little above the longest run, not far above.
SCHEDULER_LOCK_TTL=3600

# --- logging ----------------------------------------------------------------

# emergency, alert, critical, error, warning, notice, info or debug. Unset means
# debug when APP_DEBUG is true and info otherwise.
# LOG_LEVEL=info

# For the database writer, when logging.writers names it. Empty means the
# default connection. `php laika migrate` creates the table.
# LOG_CONNECTION=

# --- observability ----------------------------------------------------------

# Time hooks, filters, module stages and queries, and write where the time went
# to the "profile" log channel -- plus a Server-Timing header when APP_DEBUG is
# also on. Off means nothing is attached at all. Switch it on to find out where
# a slow page goes; do not leave it on.
APP_PROFILE=false

# Log a warning on the "database" channel for any statement slower than this
# many milliseconds, whether or not profiling is on. 0 is off. The SQL is logged
# and its bound values never are.
SLOW_QUERY_MS=0
