[Unit]
Description=LPanel root password check (ADR-0010)
Requires=lpanel-authd.socket
After=lpanel-authd.socket

[Service]
Type=simple
ExecStart=/usr/lib/lpanel/lpanel-authd --config /etc/lpanel/authd.json
Restart=on-failure
RestartSec=5s
# Root, to read /etc/shadow as its owner. Nothing else is needed or allowed.
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_AUDIT_WRITE
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# pam_faillock and friends may keep state here.
ReadWritePaths=-/run/faillock -/var/run/faillock
