[Unit]
Description=LPanel agent (privileged operations for the panel)
Documentation=file:///usr/local/lpanel/design/ARCHITECTURE.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/lpa/bin/lpa serve -config /etc/lpa/lpa.json
Restart=on-failure
RestartSec=2
# Background operations get time to finish and record their outcome.
TimeoutStopSec=90
# /run/lpa: the socket. /var/lib/lpa: the journal.
RuntimeDirectory=lpa
RuntimeDirectoryMode=0755
StateDirectory=lpa
StateDirectoryMode=0700
UMask=0077
# No NoNewPrivileges=: the agent runs system tools (useradd, restorecon,
# mariadb, restic...) that SELinux moves into their own domains. Under
# NoNewPrivileges, the kernel refuses each of those moves unless the policy
# allows it, one tool at a time. Settings that would imply NoNewPrivileges
# (SystemCallFilter=, RestrictAddressFamilies=...) are left out for the same
# reason.
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
