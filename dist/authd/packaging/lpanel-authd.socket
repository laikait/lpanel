[Unit]
Description=LPanel root password check (socket)

[Socket]
ListenStream=/run/lpanel-authd/authd.sock
# Only the panel's PHP user may connect; authd also checks SO_PEERCRED.
SocketUser=root
SocketGroup=lpanel
SocketMode=0660
# systemd makes the directory root:root, so it must be traversable for the
# panel's user to reach the socket; the socket's own mode is the gate.
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
