{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}API tokens{% endblock %}
{% block crumb %}<span class="text-body-secondary">Your account</span>{{ ui.icon('chevron-right') }}<span>API tokens</span>{% endblock %}

{% block content %}
{{ ui.page_header('API tokens', 'Let your own scripts call the LPanel API as you.') }}

{% if error %}{{ ui.alert('danger', error) }}{% endif %}

{% if created %}
<section class="card lp-card lp-card--highlight mb-4">
  <div class="card-body">
    <div class="d-flex align-items-start gap-3">
      <span class="lp-chip lp-chip--success">{{ ui.icon('check') }}</span>
      <div class="flex-grow-1 min-w-0">
        <h2 class="lp-card__title mb-1">Token “{{ created.name }}” created</h2>
        <p class="text-body-secondary small mb-3">Copy it now. It will not be shown again: LPanel keeps only a fingerprint of it.</p>
        <div class="lp-token">
          <code id="lp-new-token">{{ created.value }}</code>
          <button type="button" class="btn btn-primary btn-sm lp-btn-icon" data-lp-copy="#lp-new-token">{{ ui.icon('copy') }}<span>Copy</span></button>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<div class="row g-4">
  <div class="col-xl-8">
    <section class="card lp-card">
      <div class="lp-card__header">
        <div>
          <h2 class="lp-card__title">Your tokens</h2>
          <p class="lp-card__subtitle">A token acts with your roles, as they are at each request.</p>
        </div>
      </div>
      {% if tokens is empty %}
        {{ ui.empty('key', 'No API tokens yet', allowed ? 'Create one to call the API from a script or a CI job.' : 'Root signs in only with the server password.') }}
      {% else %}
      <div class="table-responsive">
        <table class="table lp-table align-middle mb-0">
          <thead><tr><th>Name</th><th>Token</th><th>Status</th><th>Last used</th><th>Expires</th><th class="text-end"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody>
          {% for row in tokens %}
            {% set t = row.token %}
            <tr class="{{ row.state != 'active' ? 'lp-row-muted' : '' }}">
              <td class="fw-medium text-nowrap">{{ t.name }}</td>
              <td><code class="lp-mono-chip">{{ t.prefix }}…</code></td>
              <td>{{ ui.status_badge(row.state) }}</td>
              <td class="small">{{ ui.time(t.lastUsedAt) }}{% if t.lastUsedIp %}<div class="text-body-tertiary font-monospace">{{ t.lastUsedIp }}</div>{% endif %}</td>
              <td class="small text-nowrap">{{ ui.time(t.expiresAt.format('Y-m-d H:i:s')) }}</td>
              <td class="text-end">
                {% if row.state == 'active' %}
                <form method="post" action="{{ row.revoke }}" data-lp-confirm="Anything using “{{ t.name }}” will stop working at once." data-lp-confirm-title="Revoke this token?" data-lp-confirm-ok="Revoke">
                  {{ ui.csrf(token) }}
                  <button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button>
                </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </section>
  </div>

  <div class="col-xl-4">
    {% if allowed %}
    <section class="card lp-card mb-4">
      <div class="lp-card__header"><h2 class="lp-card__title">New token</h2></div>
      <div class="card-body">
        <form method="post" action="{{ store_url }}" novalidate>
          {{ ui.csrf(token) }}
          <div class="mb-3">
            <label class="form-label" for="token-name">Name</label>
            <input class="form-control" id="token-name" name="name" maxlength="100" required placeholder="e.g. Deploy script" value="{{ old.name|default('') }}">
            <div class="form-text">So you know what uses it.</div>
          </div>
          <div class="mb-4">
            <label class="form-label" for="token-days">Expires after</label>
            <select class="form-select" id="token-days" name="days">
              {% for d in lifetimes %}<option value="{{ d }}"{{ (old.days|default(90)) == d ? ' selected' : '' }}>{{ d == 365 ? '1 year' : d ~ ' days' }}</option>{% endfor %}
            </select>
          </div>
          <button class="btn btn-primary w-100 lp-btn-icon" type="submit">{{ ui.icon('plus') }}Create token</button>
        </form>
      </div>
    </section>
    {% else %}
    <div class="lp-callout mb-4">
      {{ ui.icon('lock') }}
      <div><strong>Root has no API tokens.</strong> A token would be a way in as root that skips root's IP allowlist and lockout. Create an administrator for automation.</div>
    </div>
    {% endif %}

    <section class="card lp-card">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-2">Using a token</h2>
        <p class="small text-body-secondary">Send it as a bearer token to the <code>/api/token/v1</code> routes:</p>
        <pre class="lp-pre"><code>curl -H "Authorization: Bearer lpat_…" \
  {{ api_base }}/session</code></pre>
        <p class="small text-body-secondary mb-0">Revoked and expired tokens get <code>401</code>. A suspended account's tokens stop working too.</p>
      </div>
    </section>
  </div>
</div>
{% endblock %}
