{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Users{% endblock %}
{% block crumb %}<span class="text-body-secondary">Administration</span>{{ ui.icon('chevron-right') }}<span>Users</span>{% endblock %}

{% block content %}
<div class="lp-page-header">
  <div>
    <h1 class="lp-page-title">Users</h1>
    <p class="lp-page-subtitle">Everyone who can sign in to this panel.</p>
  </div>
  {% if can_manage %}
  <div class="lp-page-actions">
    <a class="btn btn-primary lp-btn-icon" href="{{ create_url }}">{{ ui.icon('user-plus') }}New user</a>
  </div>
  {% endif %}
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--primary">{{ ui.icon('users') }}</span><div><div class="lp-stat__value">{{ counts.total }}</div><div class="lp-stat__label">Users</div></div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--violet">{{ ui.icon('shield') }}</span><div><div class="lp-stat__value">{{ counts.admins }}</div><div class="lp-stat__label">Administrators</div></div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--success">{{ ui.icon('user') }}</span><div><div class="lp-stat__value">{{ counts.customers }}</div><div class="lp-stat__label">Customers</div></div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--amber">{{ ui.icon('phone') }}</span><div><div class="lp-stat__value">{{ counts.two_factor }}<span class="lp-stat__of">/{{ counts.total }}</span></div><div class="lp-stat__label">Use two-factor</div></div></div>
  </div>
</div>

<section class="card lp-card">
  <form method="get" action="{{ index_url }}" class="lp-toolbar" role="search">
    <div class="lp-input-icon lp-toolbar__search">
      {{ ui.icon('search') }}
      <input class="form-control" type="search" name="q" value="{{ search }}" placeholder="Search by name, login or email" aria-label="Search users" maxlength="100">
    </div>
    <select class="form-select lp-toolbar__select" name="role" aria-label="Filter by role" data-lp-autosubmit>
      <option value="">All roles</option>
      <option value="root"{{ role == 'root' ? ' selected' : '' }}>Root</option>
      <option value="admin"{{ role == 'admin' ? ' selected' : '' }}>Administrators</option>
      <option value="customer"{{ role == 'customer' ? ' selected' : '' }}>Customers</option>
    </select>
    <button class="btn btn-light" type="submit">Search</button>
    {% if search or role %}<a class="btn btn-link" href="{{ index_url }}">Clear</a>{% endif %}
  </form>

  {% if rows is empty %}
    {% if search or role %}
      {{ ui.empty('search', 'No users match', 'Try a different search, or clear the filters.') }}
    {% else %}
      {{ ui.empty('users', 'No users yet', 'Root signs in with the server password. Create users for administrators and customers.') }}
    {% endif %}
  {% else %}
  <div class="table-responsive">
    <table class="table lp-table lp-table--hover align-middle mb-0">
      <thead>
        <tr><th>User</th><th>Roles</th><th class="d-none d-lg-table-cell">Two-factor</th><th class="d-none d-sm-table-cell">Status</th><th class="d-none d-md-table-cell">Last sign-in</th><th class="text-end"><span class="visually-hidden">Open</span></th></tr>
      </thead>
      <tbody>
      {% for row in rows %}
        {% set u = row.user %}
        <tr data-lp-href="{{ row.url }}">
          <td>
            <div class="lp-person">
              {{ ui.avatar(u.name) }}
              <div class="min-w-0">
                <a class="lp-person__name stretched-link-row" href="{{ row.url }}">{{ u.name }}</a>
                <div class="lp-person__meta"><span class="font-monospace">{{ u.login }}</span>{% if u.email %} · {{ u.email }}{% endif %}</div>
              </div>
            </div>
          </td>
          <td>{% for r in u.effectiveRoles %}{{ ui.role_badge(r) }} {% else %}<span class="text-body-tertiary small">None</span>{% endfor %}</td>
          <td class="d-none d-lg-table-cell">{% if u.hasTwoFactor %}<span class="lp-yes">{{ ui.icon('check-circle') }}On</span>{% else %}<span class="lp-no">Off</span>{% endif %}</td>
          <td class="d-none d-sm-table-cell">{{ ui.status_badge(u.status) }}</td>
          <td class="small d-none d-md-table-cell">{{ ui.time(u.lastLoginAt) }}</td>
          <td class="text-end"><span class="lp-row-chev">{{ ui.icon('chevron-right') }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="lp-card__footer">Showing {{ rows|length }} of {{ total }} user{{ total == 1 ? '' : 's' }}</div>
  {% endif %}
</section>
{% endblock %}
