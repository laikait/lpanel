{% extends "auth.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Sign in{% endblock %}
{% block heading %}Sign in{% endblock %}
{% block lead %}Welcome back. Sign in to manage your hosting.{% endblock %}

{% block form %}
<form method="post" action="{{ urls.login }}" class="lp-form" autocomplete="on" novalidate>
  {{ ui.csrf(token) }}
  <div class="mb-3">
    <label class="form-label" for="login">Login name</label>
    <div class="lp-input-icon">
      {{ ui.icon('user') }}
      <input class="form-control" id="login" name="login" value="{{ old }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus maxlength="190" placeholder="e.g. root or jane">
    </div>
  </div>
  <div class="mb-2">
    {{ ui.password('password', 'password', 'Password', 'current-password') }}
  </div>
  <div class="d-flex justify-content-end mb-4">
    {% if urls.forgot is defined %}<a class="lp-link small" href="{{ urls.forgot }}">Forgot your password?</a>{% endif %}
  </div>
  <button class="btn btn-primary btn-lg w-100 lp-btn-icon" type="submit">{{ ui.icon('login') }}Sign in</button>
</form>

<div class="lp-callout mt-4">
  {{ ui.icon('terminal') }}
  <div><strong>Server administrators</strong> sign in as <code>root</code> with the server's root password.</div>
</div>
{% endblock %}
