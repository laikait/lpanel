{% extends "@Panel/auth.twig" %}

{% block form %}
<span class="area-chip">{{ icon('shield') }}{{ 'Identity.two_step'|local }}</span>
<h1>{{ 'Identity.enter_code'|local }}</h1>
<p class="lead">{{ 'Identity.enter_code_lead'|local }}</p>

{% if error %}
    <div class="alert alert-error" role="alert">{{ icon('alert') }}<p>{{ error|local }}</p></div>
{% endif %}

<form method="post" action="{{ action }}" novalidate>
    <input type="hidden" name="_token" value="{{ lp.token }}">
    <div class="field">
        <label for="code">{{ 'Identity.code'|local }}</label>
        <input class="input input-code" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="20" required autofocus>
        <div class="hint">{{ 'Identity.recovery_hint'|local }}</div>
    </div>
    <button class="btn btn-primary btn-block" type="submit">{{ icon('check') }}{{ 'Identity.verify'|local }}</button>
</form>
<p class="auth-foot"><a href="{{ back }}">{{ 'Identity.start_over'|local }}</a></p>
{% endblock %}
