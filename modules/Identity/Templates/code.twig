{% extends "auth.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Two-factor code{% endblock %}
{% block icon %}<div class="lp-auth__badge">{{ ui.icon('phone') }}</div>{% endblock %}
{% block heading %}Two-factor sign-in{% endblock %}
{% block lead %}Open your authenticator app and enter the 6-digit code for LPanel.{% endblock %}

{% block form %}
<form method="post" action="{{ urls.login_code }}" class="lp-form" novalidate>
  {{ ui.csrf(token) }}
  <div class="mb-4">
    <label class="form-label" for="code">Code</label>
    <input class="form-control form-control-lg lp-otp" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus maxlength="64" placeholder="000000">
    <div class="form-text">Lost your phone? Enter one of your recovery codes instead.</div>
  </div>
  <button class="btn btn-primary btn-lg w-100" type="submit">Verify and continue</button>
</form>
<p class="text-center mt-4 mb-0"><a class="lp-link small" href="{{ urls.login }}">{{ ui.icon('arrow-left') }} Back to sign in</a></p>
{% endblock %}
