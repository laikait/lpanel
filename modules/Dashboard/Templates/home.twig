{% extends "layout.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<h1 class="h4 mb-3">Welcome, {{ me.name }}</h1>

{% if admin %}
<div class="row g-3">
  <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body">
    <h2 class="h6">Servers</h2>
    <p class="text-body-secondary small mb-0">Pairing and health arrive with milestone M3.</p>
  </div></div></div>
  <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body">
    <h2 class="h6">Users</h2>
    <p class="text-body-secondary small mb-0">Managed through <code>/api/v1/users</code>; the screens arrive in M2b.</p>
  </div></div></div>
  <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body">
    <h2 class="h6">Audit log</h2>
    <p class="text-body-secondary small mb-0">Readable at <code>/api/v1/audit</code>.</p>
  </div></div></div>
</div>
{% elseif customer %}
<p>Your hosting account will appear here once websites are available (milestone M6).</p>
{% else %}
<p>Your account has no role yet. Ask an administrator to give it one.</p>
{% endif %}
{% endblock %}
