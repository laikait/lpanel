{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Dashboard{% endblock %}
{% block crumb %}<span>Dashboard</span>{% endblock %}

{% block content %}
<div class="lp-hero">
  <div>
    <div class="lp-eyebrow">{{ profile.root ? 'Server root' : profile.role }}</div>
    <h1 class="lp-page-title">Welcome back, {{ me.name }}</h1>
    <p class="lp-page-subtitle mb-0">{{ admin ? 'Here is what is happening on your panel.' : (customer ? 'Your hosting at a glance.' : 'Your account is ready.') }}</p>
  </div>
  {% if links.new_user is defined %}
  <div class="lp-page-actions">
    <a class="btn btn-primary lp-btn-icon" href="{{ links.new_user }}">{{ ui.icon('user-plus') }}New user</a>
  </div>
  {% endif %}
</div>

{% if user and not user.hasTwoFactor and urls.security is defined %}
<div class="lp-banner mb-4">
  <span class="lp-chip lp-chip--amber">{{ ui.icon('shield') }}</span>
  <div class="flex-grow-1">
    <div class="fw-semibold">Protect your account with two-factor sign-in</div>
    <div class="small text-body-secondary">{{ profile.root ? 'Root can change everything on this server. A second factor stops a stolen password from being enough.' : 'A code from your phone as well as your password.' }}</div>
  </div>
  <a class="btn btn-sm btn-primary" href="{{ urls.security }}">Set up</a>
</div>
{% endif %}

{% if admin %}
<div class="row g-3 mb-4">
  {% if counts %}
  <div class="col-6 col-xl-3">
    <a class="lp-stat lp-stat--link" href="{{ links.users|default('#') }}">
      <div class="lp-stat__top"><span class="lp-stat__label">Users</span><span class="lp-chip lp-chip--primary">{{ ui.icon('users') }}</span></div>
      <div class="lp-stat__value">{{ counts.total }}</div>
      <div class="lp-stat__foot">{{ counts.admins }} admin{{ counts.admins == 1 ? '' : 's' }} · {{ counts.customers }} customer{{ counts.customers == 1 ? '' : 's' }}</div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    {% set pct = counts.total > 0 ? (counts.two_factor * 100 / counts.total)|round : 0 %}
    <div class="lp-stat">
      <div class="lp-stat__top"><span class="lp-stat__label">Two-factor coverage</span><span class="lp-chip lp-chip--success">{{ ui.icon('shield') }}</span></div>
      <div class="lp-stat__value">{{ pct }}<span class="lp-stat__unit">%</span></div>
      <div class="lp-meter" role="img" aria-label="{{ pct }} percent of users use two-factor"><span class="lp-meter__bar" style="width: {{ pct }}%"></span></div>
    </div>
  </div>
  {% endif %}
  {% if activity %}
  <div class="col-6 col-xl-3">
    <a class="lp-stat lp-stat--link" href="{{ links.audit|default('#') }}">
      <div class="lp-stat__top"><span class="lp-stat__label">Events, last 24 h</span><span class="lp-chip lp-chip--violet">{{ ui.icon('activity') }}</span></div>
      <div class="lp-stat__value">{{ activity.day_total }}</div>
      <div class="lp-stat__foot">Recorded in the audit log</div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a class="lp-stat lp-stat--link{{ activity.day_denied > 0 ? ' lp-stat--alert' : '' }}" href="{{ links.audit_denied|default('#') }}">
      <div class="lp-stat__top"><span class="lp-stat__label">Refused sign-ins, 24 h</span><span class="lp-chip {{ activity.day_denied > 0 ? 'lp-chip--danger' : 'lp-chip--muted' }}">{{ ui.icon('ban') }}</span></div>
      <div class="lp-stat__value">{{ activity.day_denied }}</div>
      <div class="lp-stat__foot">{{ activity.day_denied > 0 ? 'Review them in the audit log' : 'Nothing suspicious' }}</div>
    </a>
  </div>
  {% endif %}
</div>

<div class="row g-4">
  <div class="col-xl-8">
    {% if activity %}
    <section class="card lp-card h-100">
      <div class="lp-card__header">
        <div><h2 class="lp-card__title">Recent activity</h2><p class="lp-card__subtitle">The latest entries in the audit log.</p></div>
        <a class="btn btn-sm btn-light" href="{{ links.audit }}">View all</a>
      </div>
      {% if activity.events is empty %}
        {{ ui.empty('activity', 'Nothing yet', 'Sign-ins and changes will show up here.') }}
      {% else %}
      <ul class="lp-feed">
        {% for e in activity.events %}
          <li class="lp-feed__item">
            <span class="lp-feed__dot lp-feed__dot--{{ e.outcome }}"></span>
            <div class="lp-feed__body">
              <div><span class="fw-medium">{{ e.actor ? e.actor.name : 'Someone not signed in' }}</span> <span class="text-body-secondary">· {{ e.label }}</span>{% if e.metadata.login is defined and (not e.actor or e.metadata.login != e.actor.name) %} <span class="font-monospace small">{{ e.metadata.login }}</span>{% endif %}</div>
              <div class="lp-feed__meta">{{ ui.time(e.occurred_at) }}{% if e.ip %} · <span class="font-monospace">{{ e.ip }}</span>{% endif %}</div>
            </div>
            {{ ui.outcome_badge(e.outcome) }}
          </li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% endif %}
  </div>

  <div class="col-xl-4 d-flex flex-column gap-4">
    {% if servers %}
    <section class="card lp-card">
      <div class="lp-card__header">
        <h2 class="lp-card__title">Servers</h2>
        {% if links.servers is defined %}<a class="btn btn-sm btn-light" href="{{ links.servers }}">View all</a>{% endif %}
      </div>
      {% if servers.total == 0 %}
      <div class="card-body">
        <div class="lp-placeholder">
          <span class="lp-chip lp-chip--muted">{{ ui.icon('server') }}</span>
          <div>
            <div class="small text-body-secondary mb-2">No servers yet. Pair one with the LPanel agent to see its health here.</div>
            {% if links.new_server is defined %}<a class="btn btn-sm btn-primary lp-btn-icon" href="{{ links.new_server }}">{{ ui.icon('plus') }}Add server</a>{% endif %}
          </div>
        </div>
      </div>
      {% else %}
      <div class="lp-server-tally">
        <div><span class="lp-dot lp-dot--online"></span><strong>{{ servers.online }}</strong><span>online</span></div>
        <div><span class="lp-dot lp-dot--offline"></span><strong>{{ servers.offline }}</strong><span>offline</span></div>
        <div><span class="lp-dot lp-dot--pending"></span><strong>{{ servers.pending }}</strong><span>waiting</span></div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if operations and servers and servers.total > 0 %}
    <section class="card lp-card">
      <div class="lp-card__header">
        <h2 class="lp-card__title">Operations</h2>
        <a class="btn btn-sm btn-light" href="{{ links.operations }}">View all</a>
      </div>
      <div class="lp-server-tally">
        <a href="{{ links.operations_active }}"><span class="lp-dot lp-dot--running"></span><strong>{{ operations.active }}</strong><span>in progress</span></a>
        <a href="{{ links.operations_attention }}"><span class="lp-dot lp-dot--attention"></span><strong>{{ operations.attention }}</strong><span>need attention</span></a>
        <a href="{{ links.operations_failed }}"><span class="lp-dot lp-dot--failed"></span><strong>{{ operations.failed }}</strong><span>failed, 24 h</span></a>
      </div>
    </section>
    {% endif %}

    <section class="card lp-card">
      <div class="lp-card__header"><h2 class="lp-card__title">Shortcuts</h2></div>
      <div class="lp-links">
        {% if links.users is defined %}<a href="{{ links.users }}">{{ ui.icon('users') }}<span>Manage users</span>{{ ui.icon('chevron-right', 'ms-auto') }}</a>{% endif %}
        {% if links.audit is defined %}<a href="{{ links.audit }}">{{ ui.icon('activity') }}<span>Audit log</span>{{ ui.icon('chevron-right', 'ms-auto') }}</a>{% endif %}
        {% if urls.security is defined %}<a href="{{ urls.security }}">{{ ui.icon('shield') }}<span>Sign-in security</span>{{ ui.icon('chevron-right', 'ms-auto') }}</a>{% endif %}
        {% if urls.tokens is defined and not profile.root %}<a href="{{ urls.tokens }}">{{ ui.icon('key') }}<span>API tokens</span>{{ ui.icon('chevron-right', 'ms-auto') }}</a>{% endif %}
      </div>
    </section>
  </div>
</div>

{% elseif customer %}
{% if my_accounts is empty %}
<section class="card lp-card">
  {{ ui.empty('folder', 'No hosting yet', 'Once your administrator sets up a hosting account for you, it appears here, and your websites after it.') }}
</section>
{% else %}
<h2 class="lp-section-title">Your hosting accounts</h2>
<div class="row g-3">
  {% for row in my_accounts %}
  {% set a = row.account %}
  <div class="col-md-6 col-xl-4">
    <a class="lp-stat lp-stat--link h-100" href="{{ row.url }}">
      <div class="lp-stat__top">
        <span class="lp-stat__label text-truncate">{{ a.label }}</span>
        <span class="lp-chip lp-chip--{{ a.status == 'active' ? 'success' : (a.status in ['suspended', 'suspending'] ? 'amber' : (a.status == 'failed' ? 'danger' : 'muted')) }}">{{ ui.icon('folder') }}</span>
      </div>
      <div>{{ ui.status_badge(a.status) }}</div>
      <div class="lp-stat__foot"><span class="font-monospace">{{ a.systemUser }}</span>{% if row.server %} · {{ row.server.name }}{% endif %}{% if a.phpVersion %} · PHP {{ a.phpVersion }}{% endif %}</div>
    </a>
  </div>
  {% endfor %}
</div>
{% endif %}

{% else %}
<section class="card lp-card">
  {{ ui.empty('user', 'Your account has no role yet', 'Ask an administrator to make you a customer or an administrator.') }}
</section>
{% endif %}
{% endblock %}
