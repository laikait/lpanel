{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}
{% import "@Operations/macros.twig" as ops %}

{% set o = op %}
{% set tone = {'succeeded': 'success', 'failed': 'danger', 'needs_attention': 'amber', 'cancelled': 'muted', 'expired': 'muted'}[o.status] ?? 'primary' %}

{% block title %}{{ row.label }}{% endblock %}
{% block crumb %}<span class="text-body-secondary">Administration</span>{{ ui.icon('chevron-right') }}<a href="{{ index_url }}">Operations</a>{{ ui.icon('chevron-right') }}<span>{{ row.label }}</span>{% endblock %}

{% block content %}
{{ ops.watch(row.watch, o.status) }}
<div class="lp-profile-head">
  <span class="lp-chip lp-chip--{{ tone }} lp-chip--xl">{{ ui.icon(o.isLive ? 'loader' : (o.status == 'succeeded' ? 'check-circle' : (o.status == 'needs_attention' or o.status == 'failed' ? 'alert' : 'ban')), o.isLive ? 'lp-spin' : '') }}</span>
  <div class="min-w-0 flex-grow-1">
    <h1 class="lp-page-title mb-1 text-truncate">{{ row.label }}</h1>
    <div class="lp-profile-head__meta">
      {{ ui.status_badge(o.status) }}
      <code>{{ o.op }} v{{ o.opVersion }}</code>
      {% if row.server %}<span>on <a href="{{ row.server.url }}">{{ row.server.name }}</a></span>{% endif %}
      {% if o.cancelRequested and o.isLive %}<span class="lp-badge lp-badge--warning">{{ ui.icon('ban') }}Cancel requested</span>{% endif %}
    </div>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    {% if again_url and definition %}{{ ops.run(again_url, token, o.op, o.opVersion, 'refresh', 'Run again', 'btn-light', 'operation') }}{% endif %}
    {% if can_cancel %}
    <form method="post" action="{{ cancel_url }}" data-lp-confirm="{{ o.status == 'queued' ? 'No agent has taken it yet, so it will not run.' : 'The agent is asked to stop at its next check-in. If it finishes first, its result is kept.' }}" data-lp-confirm-title="Cancel this operation?" data-lp-confirm-ok="Cancel it">
      {{ ui.csrf(token) }}<button class="btn btn-sm btn-outline-danger lp-btn-icon" type="submit">{{ ui.icon('x') }}Cancel</button>
    </form>
    {% endif %}
  </div>
</div>

{% if o.isLive %}
<div class="lp-banner lp-banner--info mb-4">
  <span class="lp-chip">{{ ui.icon('clock') }}</span>
  <div class="flex-grow-1">
    <div class="fw-semibold">{{ state_text }}</div>
    <div class="small text-body-secondary">This page updates by itself. {% if o.status == 'queued' %}If no agent takes it by {{ ui.time(o.notAfter) }}, it expires.{% else %}The agent holds it until {{ ui.time(o.leaseUntil) }} and extends that while it works.{% endif %}</div>
  </div>
</div>
{% elseif o.status != 'succeeded' %}
<div class="lp-banner {{ o.status == 'needs_attention' ? 'lp-banner--warning' : 'lp-banner--danger' }} mb-4">
  <span class="lp-chip lp-chip--{{ o.status == 'needs_attention' ? 'amber' : 'danger' }}">{{ ui.icon('alert') }}</span>
  <div class="flex-grow-1 min-w-0">
    <div class="fw-semibold">{{ state_text }}{% if o.errorCode %} <code class="ms-1">{{ o.errorCode }}</code>{% endif %}</div>
    {% if o.message %}<div class="small text-body-secondary text-break">{{ o.message }}</div>{% endif %}
  </div>
</div>
{% endif %}

<div class="row g-4">
  <div class="col-xl-8 d-flex flex-column gap-4">
    <section class="card lp-card">
      <div class="lp-card__header">
        <div><h2 class="lp-card__title">Result</h2>{% if definition %}<p class="lp-card__subtitle">{{ definition.summary }}</p>{% endif %}</div>
      </div>
      {% if result is not null %}
        {{ ops.result(o.op, result, metrics, services) }}
        <details class="lp-raw">
          <summary>Raw result, as the agent sent it</summary>
          <pre><code>{{ result_json }}</code></pre>
        </details>
      {% elseif o.isLive %}
        {{ ui.empty('loader', 'Not back yet', 'The result appears here when the agent reports it.') }}
      {% else %}
        {{ ui.empty('info', 'No result', 'Only an operation that succeeded keeps one.') }}
      {% endif %}
    </section>

    <section class="card lp-card">
      <div class="lp-card__header"><h2 class="lp-card__title">History</h2></div>
      <ol class="lp-timeline">
        {% for e in events %}
        <li class="lp-timeline__item lp-timeline__item--{{ e.to_status }}">
          <span class="lp-timeline__dot" aria-hidden="true"></span>
          <div class="min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2">
              {% if e.from_status == e.to_status %}<span class="fw-medium">Cancel requested</span>{% else %}{{ ui.status_badge(e.to_status) }}{% endif %}
              <span class="small text-body-tertiary">by the {{ {'user': 'person who asked', 'agent': 'agent', 'sweeper': 'lease sweeper', 'system': 'panel'}[e.actor] ?? e.actor }}{% if e.attempt > 0 %} · attempt {{ e.attempt }}{% endif %}</span>
            </div>
            {% if e.detail.error_code is defined %}<div class="small font-monospace text-body-secondary">{{ e.detail.error_code }}</div>{% endif %}
          </div>
          <span class="small text-body-tertiary text-nowrap ms-auto">{{ ui.time(e.occurred_at) }}</span>
        </li>
        {% endfor %}
      </ol>
    </section>
  </div>

  <div class="col-xl-4 d-flex flex-column gap-4">
    <section class="card lp-card">
      <div class="lp-card__header"><h2 class="lp-card__title">Details</h2></div>
      <div class="card-body">
        <dl class="lp-dl">
          <dt>Server</dt><dd>{% if row.server %}<a href="{{ row.server.url }}">{{ row.server.name }}</a>{% else %}—{% endif %}</dd>
          <dt>Asked by</dt><dd>{{ o.requestedByName ?: '—' }}</dd>
          <dt>Queued</dt><dd>{{ ui.time(o.queuedAt) }}</dd>
          <dt>Taken by agent</dt><dd>{{ ui.time(o.claimedAt, '—') }}</dd>
          <dt>Finished</dt><dd>{{ ui.time(o.completedAt, '—') }}</dd>
          <dt>Took</dt><dd>{{ row.duration ?: '—' }}</dd>
          <dt>Attempt</dt><dd>{{ o.attempt }} of {{ o.maxAttempts }}{% if o.idempotent and not o.mutating %} <span class="text-body-tertiary small">· retried if the agent goes quiet</span>{% endif %}</dd>
          <dt>Agent version</dt><dd class="font-monospace">{{ o.agentVersion ?: '—' }}</dd>
          <dt>Changes the server</dt><dd>{{ o.mutating ? 'Yes' : 'No, read-only' }}</dd>
          <dt>Operation id</dt><dd><code class="small">{{ o.uid }}</code></dd>
        </dl>
      </div>
    </section>
  </div>
</div>
{% endblock %}
