{% import "macros/ui.twig" as ui %}
{% import "@Operations/macros.twig" as ops %}

<section class="card lp-card" id="operations">
  <div class="lp-card__header">
    <div><h2 class="lp-card__title">Operations</h2><p class="lp-card__subtitle">Signed by the panel, checked and run by the agent.</p></div>
  </div>

  <ul class="lp-oplist">
    {% for name, r in ops_runnable %}
    <li class="lp-oplist__item">
      <div class="min-w-0">
        <div class="fw-medium">{{ r.definition.label }}</div>
        <div class="small text-body-tertiary text-truncate" title="{{ r.definition.summary }}"><code>{{ name }}</code></div>
      </div>
      {% if r.live %}
        {{ ops.watch(r.live.watch, r.live.op.status) }}
        <a class="btn btn-sm btn-light lp-btn-icon" href="{{ r.live.url }}">{{ ui.icon('loader', 'lp-spin') }}{{ r.live.op.status == 'queued' ? 'Queued' : 'Running' }}</a>
      {% elseif r.allowed %}
        {{ ops.run(ops_run_url, token, name, r.definition.version, 'play', 'Run', 'btn-light') }}
      {% else %}
        <span class="small text-body-tertiary" title="{{ not r.supported ? 'This agent does not have it.' : (not ops_online ? 'The agent is not online.' : 'You may not run it.') }}">{{ not r.supported ? 'Not on this agent' : (not ops_online ? 'Agent offline' : '—') }}</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>

  <div class="lp-card__section-title">Recent</div>
  {% if ops_recent is empty %}
    <div class="card-body pt-0 small text-body-secondary">Nothing has been asked of this server's agent yet.</div>
  {% else %}
  <ul class="lp-oplist lp-oplist--recent">
    {% for row in ops_recent %}
    <li class="lp-oplist__item">
      <a class="stretched-link min-w-0 text-reset text-decoration-none" href="{{ row.url }}">
        <div class="fw-medium text-truncate">{{ row.label }}</div>
        <div class="small text-body-tertiary">{{ ui.time(row.op.queuedAt) }}</div>
      </a>
      {{ ui.status_badge(row.op.status) }}
    </li>
    {% endfor %}
  </ul>
  <div class="lp-card__footer"><a class="small fw-medium" href="{{ ops_index_url }}">All operations on this server {{ ui.icon('chevron-right') }}</a></div>
  {% endif %}
</section>
