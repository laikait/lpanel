{% import "macros/ui.twig" as ui %}
{% import "@Operations/macros.twig" as ops %}

{% set mrun = ops_runnable['system.metrics'] ?? null %}
<section class="card lp-card" id="resources">
  <div class="lp-card__header">
    <div>
      <h2 class="lp-card__title">Resources</h2>
      <p class="lp-card__subtitle">{% if ops_metrics %}Measured {{ ui.time(ops_metrics.at) }}{% if ops_metrics_url %} · <a href="{{ ops_metrics_url }}">details</a>{% endif %}{% else %}Load, memory and disk use, measured by the agent when asked.{% endif %}</p>
    </div>
    {% if mrun and mrun.live %}
      {{ ops.watch(mrun.live.watch, mrun.live.op.status) }}
      {{ ops.run(ops_run_url, token, 'system.metrics', mrun.definition.version, 'loader', 'Measuring…', 'btn-light', null, true) }}
    {% elseif mrun and mrun.allowed %}
      {{ ops.run(ops_run_url, token, 'system.metrics', mrun.definition.version, 'refresh', ops_metrics ? 'Refresh' : 'Measure now', ops_metrics ? 'btn-light' : 'btn-primary') }}
    {% endif %}
  </div>
  {% if ops_metrics %}
    <div class="card-body">{{ ops.metrics(ops_metrics) }}</div>
  {% else %}
    {{ ui.empty('gauge', 'Not measured yet', ops_online ? 'Ask the agent for this server\'s load, memory and disk use.' : 'Shown once the agent is online and has been asked.') }}
  {% endif %}
</section>

{% set srun = ops_runnable['service.list_status'] ?? null %}
<section class="card lp-card" id="services">
  <div class="lp-card__header">
    <div>
      <h2 class="lp-card__title">Services</h2>
      <p class="lp-card__subtitle">{% if ops_services is not null %}Checked {{ ui.time(ops_services_at) }}. Only the services LPanel manages.{% else %}Nginx, Apache, PHP-FPM, MariaDB and the agent itself. No other unit can be asked about.{% endif %}</p>
    </div>
    {% if srun and srun.live %}
      {{ ops.watch(srun.live.watch, srun.live.op.status) }}
      {{ ops.run(ops_run_url, token, 'service.list_status', srun.definition.version, 'loader', 'Checking…', 'btn-light', null, true) }}
    {% elseif srun and srun.allowed %}
      {{ ops.run(ops_run_url, token, 'service.list_status', srun.definition.version, 'refresh', ops_services is not null ? 'Refresh' : 'Check now', ops_services is not null ? 'btn-light' : 'btn-primary') }}
    {% endif %}
  </div>
  {% if ops_services_failure %}
    <div class="lp-inline-alert">
      {{ ui.icon('alert') }}
      <div>The last check failed: <code>{{ ops_services_failure.code }}</code>{% if ops_services_failure.message %} — {{ ops_services_failure.message }}{% endif %} <a href="{{ ops_services_failure.url }}">Details</a></div>
    </div>
  {% endif %}
  {% if ops_services is not null %}
    {{ ops.services(ops_services) }}
  {% elseif not ops_services_failure %}
    {{ ui.empty('activity', 'Not checked yet', ops_online ? 'Ask the agent which of the managed services are running.' : 'Shown once the agent is online and has been asked.') }}
  {% endif %}
</section>
