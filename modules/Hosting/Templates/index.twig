{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Hosting accounts{% endblock %}
{% block crumb %}<span class="text-body-secondary">Hosting</span>{{ ui.icon('chevron-right') }}<span>Hosting accounts</span>{% endblock %}

{% block content %}
<div class="lp-page-header">
  <div>
    <h1 class="lp-page-title">Hosting accounts</h1>
    <p class="lp-page-subtitle">{{ admin ? 'Each account is a Linux user on its server, with its own home and its own PHP. One customer cannot read another\'s files.' : 'Your hosting space on our servers: its own user, home and PHP.' }}</p>
  </div>
  {% if can_manage %}
  <div class="lp-page-actions"><a class="btn btn-primary lp-btn-icon" href="{{ create_url }}">{{ ui.icon('plus') }}New account</a></div>
  {% endif %}
</div>

{% if admin %}
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--primary">{{ ui.icon('folder') }}</span><div><div class="lp-stat__value">{{ counts.total }}</div><div class="lp-stat__label">Accounts</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--success">{{ ui.icon('check-circle') }}</span><div><div class="lp-stat__value">{{ counts.active }}</div><div class="lp-stat__label">Active</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--amber">{{ ui.icon('pause') }}</span><div><div class="lp-stat__value">{{ counts.suspended }}</div><div class="lp-stat__label">Suspended</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact{{ counts.failed > 0 ? ' lp-stat--alert' : '' }}"><span class="lp-chip {{ counts.failed > 0 ? 'lp-chip--danger' : 'lp-chip--muted' }}">{{ ui.icon('alert') }}</span><div><div class="lp-stat__value">{{ counts.failed }}</div><div class="lp-stat__label">Failed to set up</div></div></div></div>
</div>
{% endif %}

<section class="card lp-card">
  {% if admin %}
  <div class="lp-toolbar">
    <div class="lp-segmented" role="group" aria-label="State">
      {% for key, label in {'current': 'All', 'active': 'Active', 'suspended': 'Suspended', 'busy': 'In progress', 'failed': 'Failed', 'deleted': 'Deleted'} %}
        <a class="lp-segmented__item{{ group == key ? ' active' : '' }}" href="{{ index_url }}{{ key == 'current' ? '' : '?status=' ~ key }}"{% if group == key %} aria-current="true"{% endif %}>{{ label }}{% if key != 'current' and key != 'deleted' and counts[key] > 0 %} <span class="lp-count">{{ counts[key] }}</span>{% endif %}</a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if rows is empty %}
    {% if group != 'current' %}
      {{ ui.empty('folder', 'Nothing here', 'No account is in this state right now.') }}
    {% elseif admin %}
    <div class="lp-empty">
      <span class="lp-empty__icon">{{ ui.icon('folder') }}</span>
      <h3 class="lp-empty__title">No hosting accounts yet</h3>
      <p class="lp-empty__text">An account gives a customer a Linux user, a home and a PHP-FPM pool of their own on one of your servers. Websites come next.</p>
      {% if can_manage %}<a class="btn btn-primary lp-btn-icon mt-3" href="{{ create_url }}">{{ ui.icon('plus') }}Create the first account</a>{% endif %}
    </div>
    {% else %}
      {{ ui.empty('folder', 'No hosting accounts yet', 'Your administrator sets up hosting accounts. Once one is ready, it appears here.') }}
    {% endif %}
  {% else %}
  <div class="table-responsive">
    <table class="table lp-table lp-table--hover align-middle mb-0">
      <thead><tr><th>Account</th><th>Status</th>{% if admin %}<th class="d-none d-md-table-cell">Customer</th>{% endif %}<th class="d-none d-sm-table-cell">Server</th><th class="d-none d-lg-table-cell">PHP</th><th class="d-none d-lg-table-cell">Created</th><th class="text-end"><span class="visually-hidden">Open</span></th></tr></thead>
      <tbody>
      {% for row in rows %}
        {% set a = row.account %}
        <tr class="{{ a.status == 'deleted' ? 'lp-row-muted' : '' }}">
          <td>
            <div class="lp-person">
              <span class="lp-chip lp-chip--{{ a.status == 'active' ? 'success' : (a.status in ['failed', 'deleting'] ? 'danger' : (a.status in ['suspended', 'suspending'] ? 'amber' : 'muted')) }} lp-chip--sm">{{ ui.icon('folder') }}</span>
              <div class="min-w-0">
                <a class="lp-person__name stretched-link-row" href="{{ row.url }}">{{ a.label }}</a>
                <div class="lp-person__meta font-monospace">{{ a.systemUser }}</div>
              </div>
            </div>
          </td>
          <td>
            {{ ui.status_badge(a.status) }}
            {% if a.lastError and not a.busy %}<div class="small text-danger-emphasis mt-1 text-truncate lp-cell-note" title="{{ a.lastError }}">{{ ui.icon('alert') }} Last {{ a.lastAction }} failed</div>{% endif %}
          </td>
          {% if admin %}<td class="d-none d-md-table-cell small">{% if row.owner %}<span class="lp-cell-strong">{{ row.owner.name }}</span><div class="text-body-tertiary">{{ row.owner.login }}</div>{% else %}<span class="text-body-tertiary">—</span>{% endif %}</td>{% endif %}
          <td class="d-none d-sm-table-cell small">{{ row.server ? row.server.name : '—' }}</td>
          <td class="d-none d-lg-table-cell small font-monospace">{{ a.phpVersion ?: '—' }}</td>
          <td class="d-none d-lg-table-cell small text-nowrap">{{ ui.time(a.createdAt) }}</td>
          <td class="text-end"><span class="lp-row-chev">{{ ui.icon('chevron-right') }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
{% endblock %}
