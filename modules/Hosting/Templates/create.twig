{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}New hosting account{% endblock %}
{% block crumb %}<span class="text-body-secondary">Hosting</span>{{ ui.icon('chevron-right') }}<a href="{{ index_url }}">Hosting accounts</a>{{ ui.icon('chevron-right') }}<span>New account</span>{% endblock %}

{% set usable = servers|filter(s => s.usable) %}

{% block content %}
{{ ui.page_header('New hosting account', 'A Linux user, home and PHP-FPM pool for one customer, on one server.') }}

<div class="row g-4">
  <div class="col-xl-7">
    {% if error %}{{ ui.alert('danger', error) }}{% endif %}

    {% if usable is empty or customers is empty %}
    <section class="card lp-card mb-4 lp-card--warn">
      <div class="lp-card__header">
        <div class="lp-card__heading">
          <span class="lp-chip lp-chip--amber">{{ ui.icon('alert') }}</span>
          <div><h2 class="lp-card__title">Two things are needed first</h2><p class="lp-card__subtitle">An account lives on a server and belongs to a customer.</p></div>
        </div>
      </div>
      <div class="card-body">
        <ol class="lp-checklist">
          <li class="{{ usable is empty ? '' : 'is-done' }}">A paired, online server whose agent manages accounts. {% if usable is empty %}<a href="{{ servers_url }}">Servers</a>{% endif %}</li>
          <li class="{{ customers is empty ? '' : 'is-done' }}">A panel user with the customer role. {% if customers is empty %}<a href="{{ users_url }}">Users</a>{% endif %}</li>
        </ol>
      </div>
    </section>
    {% endif %}

    <form method="post" action="{{ store_url }}" class="card lp-card" novalidate>
      {{ ui.csrf(token) }}
      <div class="card-body d-flex flex-column gap-4">
        <div>
          <label class="form-label" for="label">Account name</label>
          <input class="form-control" id="label" name="label" value="{{ input.label }}" maxlength="100" required autofocus placeholder="e.g. Acme Ltd, or acme.example">
          <div class="form-text">For people. The server gets a user name of its own, like <code>lpq3x7k2ma</code>.</div>
        </div>

        <div>
          <label class="form-label" for="owner">Customer</label>
          <select class="form-select" id="owner" name="owner" required{{ customers is empty ? ' disabled' : '' }}>
            <option value="">Choose a customer…</option>
            {% for c in customers %}<option value="{{ c.id }}"{{ input.owner == c.id ? ' selected' : '' }}>{{ c.name }} ({{ c.login }})</option>{% endfor %}
          </select>
          <div class="form-text">They see this account in their panel. They cannot see anyone else's.</div>
        </div>

        <fieldset>
          <legend class="form-label">Server</legend>
          {% if servers is empty %}
            <div class="text-body-secondary small">No paired servers yet.</div>
          {% endif %}
          <div class="lp-choice-list">
            {% for s in servers %}
            <label class="lp-choice{{ s.usable ? '' : ' is-disabled' }}">
              <input class="form-check-input" type="radio" name="server" value="{{ s.id }}"{{ input.server == s.id or (input.server == '' and usable|length == 1 and s.usable) ? ' checked' : '' }}{{ s.usable ? '' : ' disabled' }}>
              <span class="lp-chip lp-chip--{{ s.usable ? 'success' : 'muted' }} lp-chip--sm">{{ ui.icon('server') }}</span>
              <span class="min-w-0 flex-grow-1">
                <span class="d-block fw-medium">{{ s.name }}</span>
                <span class="d-block small text-body-tertiary font-monospace text-truncate">{{ s.detail ?: '—' }}</span>
              </span>
              {% if s.note %}<span class="lp-badge lp-badge--secondary">{{ s.note }}</span>{% endif %}
            </label>
            {% endfor %}
          </div>
        </fieldset>
      </div>
      <div class="lp-card__footer lp-card__footer--actions gap-2">
        <a class="btn btn-light" href="{{ index_url }}">Cancel</a>
        <button class="btn btn-primary lp-btn-icon" type="submit"{{ usable is empty or customers is empty ? ' disabled' : '' }}>{{ ui.icon('plus') }}Create account</button>
      </div>
    </form>
  </div>

  <div class="col-xl-5">
    <section class="card lp-card">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">What the server gets</h2>
        <ol class="lp-steps lp-steps--compact">
          <li><div class="lp-steps__title">Its own Linux user</div><p class="small text-body-secondary mb-0">No password and no shell. Its uid is from a range kept for accounts, never a person's.</p></li>
          <li><div class="lp-steps__title">A private home</div><p class="small text-body-secondary mb-0"><code>/home/&lt;user&gt;</code> with <code>web</code>, <code>tmp</code> and <code>logs</code>. Other accounts cannot even list it.</p></li>
          <li><div class="lp-steps__title">PHP that runs as the account</div><p class="small text-body-secondary mb-0">A PHP-FPM pool of its own, kept inside the home. Its sessions and uploads stay private.</p></li>
        </ol>
        <p class="small text-body-tertiary mb-0 mt-3">The agent's privileged half does this on the server, and only after checking the panel's signature itself.</p>
      </div>
    </section>
  </div>
</div>
{% endblock %}
