{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Pair {{ server.name }}{% endblock %}
{% block crumb %}<span class="text-body-secondary">Administration</span>{{ ui.icon('chevron-right') }}<a href="{{ index_url }}">Servers</a>{{ ui.icon('chevron-right') }}<span>{{ server.name }}</span>{% endblock %}

{% block content %}
{{ ui.page_header('Pair ' ~ server.name, 'Run this on the server, as root, within ' ~ minutes ~ ' minutes.') }}

<section class="card lp-card lp-card--highlight mb-4">
  <div class="card-body">
    <div class="d-flex align-items-start gap-3">
      <span class="lp-chip lp-chip--success">{{ ui.icon('terminal') }}</span>
      <div class="flex-grow-1 min-w-0">
        <h2 class="lp-card__title mb-1">Your pairing command</h2>
        <p class="text-body-secondary small mb-3">It contains a one-time token. Copy it now: it is not shown again, and the panel keeps only a fingerprint of it.</p>
        <div class="lp-token lp-token--command">
          <code id="lp-enroll-command">{{ command }}</code>
          <button type="button" class="btn btn-primary btn-sm lp-btn-icon" data-lp-copy="#lp-enroll-command">{{ ui.icon('copy') }}<span>Copy</span></button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-lg-7">
    <section class="card lp-card h-100">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">What happens next</h2>
        <ol class="lp-steps lp-steps--compact">
          <li><div class="lp-steps__title">The agent makes its own keys</div><p class="small text-body-secondary mb-0">A signing key and a TLS certificate, kept on the server in <code>/etc/lpa</code>. They never leave it.</p></li>
          <li><div class="lp-steps__title">It checks it is talking to this panel</div><p class="small text-body-secondary mb-0">By the pin in the command. A different certificate, even a valid one, is refused.</p></li>
          <li><div class="lp-steps__title">The panel spends the token</div><p class="small text-body-secondary mb-0">A second use, an expired token or a wrong one are all refused, and recorded in the audit log.</p></li>
          <li><div class="lp-steps__title">Start the agent</div><p class="small text-body-secondary mb-0"><code>sudo systemctl enable --now lpa-agent</code>. The server shows as online at its first heartbeat.</p></li>
        </ol>
      </div>
    </section>
  </div>
  <div class="col-lg-5">
    <section class="card lp-card h-100">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Check the panel's identity</h2>
        <p class="small text-body-secondary">On the server, <code>lpa pin {{ panel_url }}</code> prints the key the panel presents. It must be:</p>
        <code class="lp-secret d-block mb-4">{{ pin }}</code>
        <div class="d-flex gap-2">
          <a class="btn btn-primary" href="{{ show_url }}">Go to the server</a>
          <a class="btn btn-light" href="{{ index_url }}">All servers</a>
        </div>
      </div>
    </section>
  </div>
</div>
{% endblock %}
