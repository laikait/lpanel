{% set a = account %}
<div class="card">
    <div class="card-head">
        <div><h2>{{ a.domain }}</h2><p>{{ 'Accounts.your_package'|local({name: a.package_name}) }}</p></div>
        {% include "@Accounts/status.twig" with {a: a} %}
    </div>
    {% if a.status == 'creating' %}
        <div class="card-body"><div class="alert alert-info" style="margin:0">{{ icon('clock') }}<p>{{ 'Accounts.being_set_up'|local }}</p></div></div>
    {% endif %}
    <div class="grid grid-3" style="gap:0">
        <div class="stat">
            <span class="stat-icon">{{ icon('disk') }}</span>
            <div style="flex:1">
                <div class="stat-label">{{ 'Accounts.disk'|local }}</div>
                <div class="stat-value">{{ a.disk_used_bytes is null ? '—' : a.disk_used_bytes|bytes }}</div>
                <div class="stat-sub">{{ a.disk_limit_bytes ? 'Accounts.limit_of'|local({limit: a.disk_limit_bytes|bytes}) : 'Accounts.unlimited'|local }}</div>
                {% if a.disk_percent is not null %}<div class="meter{% if a.disk_percent >= 95 %} is-bad{% elseif a.disk_percent >= 80 %} is-warn{% endif %}"><span style="width:{{ a.disk_percent }}%"></span></div>{% endif %}
            </div>
        </div>
        <div class="stat">
            <span class="stat-icon">{{ icon('folder') }}</span>
            <div>
                <div class="stat-label">{{ 'Accounts.files'|local }}</div>
                <div class="stat-value">{{ a.inodes_used is null ? '—' : a.inodes_used|number_format }}</div>
                <div class="stat-sub">{{ a.package.inodes|default(0) ? 'Accounts.limit_of'|local({limit: a.package.inodes|number_format}) : 'Accounts.unlimited'|local }}</div>
            </div>
        </div>
        <div class="stat">
            <span class="stat-icon">{{ icon('globe') }}</span>
            <div>
                <div class="stat-label">{{ 'Accounts.home'|local }}</div>
                <div class="stat-value mono" style="font-size:15px">{{ a.home ?: '—' }}</div>
                <div class="stat-sub">{{ 'Accounts.web_root'|local }}</div>
            </div>
        </div>
    </div>
</div>
