{% import "macros/ui.twig" as ui %}

<section class="card lp-card" id="websites">
  <div class="lp-card__header">
    <div><h2 class="lp-card__title">Websites</h2><p class="lp-card__subtitle">{{ site_count }} on this server's Nginx. Checked every hour for hand edits.</p></div>
  </div>
  <div class="card-body d-flex flex-column gap-3">
    {% if site_check %}
    <div class="lp-facts lp-facts--compact">
      <div><span>Last check</span><strong><a href="{{ site_check.url }}">{{ ui.time(site_check.at) }}</a></strong></div>
      <div><span>Files</span><strong>{{ site_check.checked }} checked{% if site_edited is not empty %}, <em class="fst-normal text-warning-emphasis">{{ site_edited|length }} changed</em>{% endif %}</strong></div>
      {% if site_check.nginx_test != 'not_run' %}<div><span>nginx -t</span><strong>{{ site_check.nginx_test == 'passed' ? (site_check.reloaded ? 'Passed; reloaded' : 'Passed') : 'Failed; not reloaded' }}</strong></div>{% endif %}
      {% if site_check.include != 'ok' and site_check.include != 'none' %}<div><span>Include</span><strong class="text-warning-emphasis">{{ site_check.include == 'edited' ? 'edited outside LPanel' : 'missing' }}</strong></div>{% endif %}
      {% if site_check.unknown is not empty %}<div><span>Not LPanel's</span><strong class="font-monospace small">{{ site_check.unknown|join(', ') }}</strong></div>{% endif %}
    </div>
    {% else %}
    <p class="small text-body-secondary mb-0">Not checked yet. A check compares each website's Nginx file with the one LPanel wrote.</p>
    {% endif %}

    {% for row in site_edited %}
    <a class="lp-banner lp-banner--warning lp-banner--link mb-0" href="{{ row.url }}">
      <span class="lp-chip lp-chip--amber lp-chip--sm">{{ ui.icon('alert') }}</span>
      <span class="min-w-0 flex-grow-1"><span class="d-block fw-medium text-truncate">{{ row.website.domain }}</span><span class="d-block small text-body-secondary">{{ row.website.configState == 'missing' ? 'File missing' : 'Edited outside LPanel' }}</span></span>
      {{ ui.icon('chevron-right') }}
    </a>
    {% endfor %}

    {% if site_can_check %}
    <form method="post" action="{{ site_check_url }}">
      {{ ui.csrf(token) }}<input type="hidden" name="server" value="{{ site_server.uid }}">
      <button class="btn btn-sm btn-light lp-btn-icon w-100 justify-content-center" type="submit">{{ ui.icon('refresh') }}Check now</button>
    </form>
    {% endif %}
  </div>
</section>
