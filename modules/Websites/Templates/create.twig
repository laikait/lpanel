{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}New website{% endblock %}
{% block crumb %}<span class="text-body-secondary">Hosting</span>{{ ui.icon('chevron-right') }}<a href="{{ index_url }}">Websites</a>{{ ui.icon('chevron-right') }}<span>New website</span>{% endblock %}

{% set usable = accounts|filter(a => a.usable) %}

{% block content %}
{{ ui.page_header('New website', 'Served by the account\'s server through its own Nginx, with PHP from the account\'s own pool.') }}

<div class="row g-4">
  <div class="col-xl-7">
    {% if error %}{{ ui.alert('danger', error) }}{% endif %}

    {% if usable is empty %}
    <section class="card lp-card mb-4 lp-card--warn">
      <div class="lp-card__header">
        <div class="lp-card__heading">
          <span class="lp-chip lp-chip--amber">{{ ui.icon('alert') }}</span>
          <div><h2 class="lp-card__title">A hosting account comes first</h2><p class="lp-card__subtitle">A website lives in an account: its files in the account's web folder, its PHP running as the account.</p></div>
        </div>
      </div>
      <div class="card-body">
        <ol class="lp-checklist">
          <li>An active hosting account on an online server whose agent serves websites. <a href="{{ accounts_url }}">Hosting accounts</a></li>
        </ol>
      </div>
    </section>
    {% endif %}

    <form method="post" action="{{ store_url }}" class="card lp-card" novalidate>
      {{ ui.csrf(token) }}
      <div class="card-body d-flex flex-column gap-4">
        <fieldset>
          <legend class="form-label">Hosting account</legend>
          {% if errors.account is defined %}<div class="invalid-feedback d-block mb-2">{{ errors.account }}</div>{% endif %}
          {% if accounts is empty %}
            <div class="text-body-secondary small">No active hosting accounts yet.</div>
          {% endif %}
          <div class="lp-choice-list">
            {% for a in accounts %}
            <label class="lp-choice{{ a.usable ? '' : ' is-disabled' }}">
              <input class="form-check-input" type="radio" name="account" value="{{ a.id }}"{{ input.account == a.id or (input.account == '' and usable|length == 1 and a.usable) ? ' checked' : '' }}{{ a.usable ? '' : ' disabled' }}>
              <span class="lp-chip lp-chip--{{ a.usable ? (a.suspended ? 'amber' : 'success') : 'muted' }} lp-chip--sm">{{ ui.icon('folder') }}</span>
              <span class="min-w-0 flex-grow-1">
                <span class="d-block fw-medium">{{ a.label }}</span>
                <span class="d-block small text-body-tertiary text-truncate"><span class="font-monospace">{{ a.system_user }}</span> · {{ a.server }}</span>
              </span>
              {% if a.note %}<span class="lp-badge lp-badge--secondary">{{ a.note }}</span>{% elseif a.suspended %}<span class="lp-badge lp-badge--warning">suspended</span>{% endif %}
            </label>
            {% endfor %}
          </div>
        </fieldset>

        <div>
          <label class="form-label" for="domains">Domain names</label>
          <textarea class="form-control font-monospace{{ errors.domains is defined ? ' is-invalid' : '' }}" id="domains" name="domains" rows="3" spellcheck="false" autocapitalize="off" placeholder="example.com&#10;www.example.com" required>{{ input.domains }}</textarea>
          {% if errors.domains is defined %}<div class="invalid-feedback">{{ errors.domains }}</div>{% endif %}
          <div class="form-text">One per line, the main one first; up to 10. Point their DNS at the server. HTTPS comes with certificates in the next release.</div>
        </div>

        <div>
          <label class="form-label" for="document_root">Folder</label>
          <div class="input-group">
            <span class="input-group-text font-monospace small">web/</span>
            <input class="form-control font-monospace{{ errors.document_root is defined ? ' is-invalid' : '' }}" id="document_root" name="document_root" value="{{ input.document_root }}" spellcheck="false" autocapitalize="off" placeholder="the main domain, e.g. example.com">
            {% if errors.document_root is defined %}<div class="invalid-feedback">{{ errors.document_root }}</div>{% endif %}
          </div>
          <div class="form-text">Where its files go, inside the account's web folder. LPanel makes it if it is new, with a placeholder page.</div>
        </div>

        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="php" name="php" value="1"{{ input.php ? ' checked' : '' }}>
          <label class="form-check-label" for="php">PHP</label>
          <div class="form-text mt-0">Runs <code>.php</code> files as the account, through its own pool. Off: static files only, and <code>.php</code> files are never handed out.</div>
        </div>

        <div class="form-check form-switch mt-3">
          <input type="hidden" name="https_redirect" value="0">
          <input class="form-check-input" type="checkbox" role="switch" id="https_redirect" name="https_redirect" value="1"{{ input.https_redirect ?? true ? ' checked' : '' }}>
          <label class="form-check-label" for="https_redirect">Redirect HTTP to HTTPS</label>
          <div class="form-text mt-0">LPanel gets the website a Let's Encrypt certificate on its own once its domains point at the server; then <code>http://</code> sends visitors to <code>https://</code>.</div>
        </div>
      </div>
      <div class="lp-card__footer lp-card__footer--actions gap-2">
        <a class="btn btn-light" href="{{ index_url }}">Cancel</a>
        <button class="btn btn-primary lp-btn-icon" type="submit"{{ usable is empty ? ' disabled' : '' }}>{{ ui.icon('plus') }}Create website</button>
      </div>
    </form>
  </div>

  <div class="col-xl-5">
    <section class="card lp-card">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">How it reaches Nginx</h2>
        <ol class="lp-steps lp-steps--compact">
          <li><div class="lp-steps__title">Rendered from settings</div><p class="small text-body-secondary mb-0">The agent writes the server block itself from checked values. Nothing typed here becomes configuration text.</p></li>
          <li><div class="lp-steps__title">Tested before it is live</div><p class="small text-body-secondary mb-0">The whole configuration, with this website in it, goes through <code>nginx -t</code> next to the live one. If it fails, nothing changes.</p></li>
          <li><div class="lp-steps__title">Served, then confirmed</div><p class="small text-body-secondary mb-0">After the reload the agent asks Nginx which version it serves. If the new one does not show, the previous one goes back.</p></li>
        </ol>
        <p class="small text-body-tertiary mb-0 mt-3">Redirects, headers and index files are set on the website's page once it exists.</p>
      </div>
    </section>
  </div>
</div>
{% endblock %}
