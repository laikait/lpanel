{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Websites{% endblock %}
{% block crumb %}<span class="text-body-secondary">Hosting</span>{{ ui.icon('chevron-right') }}<span>Websites</span>{% endblock %}

{% macro tone(w, row) -%}
{{ row.account_suspended or w.status in ['suspended', 'suspending'] ? 'amber' : (w.status == 'active' ? (w.configState == 'ok' ? 'success' : 'amber') : (w.status in ['failed', 'deleting'] ? 'danger' : (w.status == 'deleted' ? 'muted' : 'primary'))) }}
{%- endmacro %}

{% block content %}
<div class="lp-page-header">
  <div>
    <h1 class="lp-page-title">Websites</h1>
    <p class="lp-page-subtitle">{{ admin ? 'Served by each server\'s own Nginx, from settings LPanel checks. Nothing reaches Nginx until nginx -t has passed it.' : 'Your websites, and the settings you can change yourself.' }}</p>
  </div>
  {% if can_manage %}
  <div class="lp-page-actions"><a class="btn btn-primary lp-btn-icon" href="{{ create_url }}">{{ ui.icon('plus') }}New website</a></div>
  {% endif %}
</div>

{% if admin and counts.edited > 0 %}
<div class="lp-banner lp-banner--warning mb-4">
  <span class="lp-chip lp-chip--amber">{{ ui.icon('alert') }}</span>
  <div class="flex-grow-1">
    <div class="fw-semibold">{{ counts.edited }} website{{ counts.edited == 1 ? '' : 's' }} changed outside LPanel</div>
    <div class="small text-body-secondary">Someone edited or removed {{ counts.edited == 1 ? 'its' : 'their' }} Nginx file on the server. LPanel leaves the edit in place and changes nothing until you look and restore LPanel's version.</div>
  </div>
  <a class="btn btn-sm btn-outline-secondary" href="{{ index_url }}?status=edited">Show {{ counts.edited == 1 ? 'it' : 'them' }}</a>
</div>
{% endif %}

{% if admin %}
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--primary">{{ ui.icon('globe') }}</span><div><div class="lp-stat__value">{{ counts.total }}</div><div class="lp-stat__label">Websites</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--success">{{ ui.icon('check-circle') }}</span><div><div class="lp-stat__value">{{ counts.active }}</div><div class="lp-stat__label">Served</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact"><span class="lp-chip lp-chip--amber">{{ ui.icon('pause') }}</span><div><div class="lp-stat__value">{{ counts.suspended }}</div><div class="lp-stat__label">Suspended</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="lp-stat lp-stat--compact{{ counts.failed > 0 ? ' lp-stat--alert' : '' }}"><span class="lp-chip {{ counts.failed > 0 ? 'lp-chip--danger' : 'lp-chip--muted' }}">{{ ui.icon('alert') }}</span><div><div class="lp-stat__value">{{ counts.failed }}</div><div class="lp-stat__label">Failed to set up</div></div></div></div>
</div>
{% endif %}

<section class="card lp-card">
  {% if admin %}
  <div class="lp-toolbar">
    <div class="lp-segmented" role="group" aria-label="State">
      {% for key, label in {'current': 'All', 'active': 'Served', 'suspended': 'Suspended', 'busy': 'In progress', 'edited': 'Edited outside', 'failed': 'Failed', 'deleted': 'Deleted'} %}
        <a class="lp-segmented__item{{ group == key ? ' active' : '' }}" href="{{ index_url }}{{ key == 'current' ? '' : '?status=' ~ key }}"{% if group == key %} aria-current="true"{% endif %}>{{ label }}{% if key != 'current' and key != 'deleted' and counts[key] > 0 %} <span class="lp-count">{{ counts[key] }}</span>{% endif %}</a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if rows is empty %}
    {% if group != 'current' %}
      {{ ui.empty('globe', 'Nothing here', 'No website is in this state right now.') }}
    {% elseif admin %}
    <div class="lp-empty">
      <span class="lp-empty__icon">{{ ui.icon('globe') }}</span>
      <h3 class="lp-empty__title">No websites yet</h3>
      <p class="lp-empty__text">A website lives in a hosting account: its files in the account's <code>web/</code> folder, its PHP in the account's own pool, its Nginx configuration generated and tested by LPanel.</p>
      {% if can_manage %}<a class="btn btn-primary lp-btn-icon mt-3" href="{{ create_url }}">{{ ui.icon('plus') }}Create the first website</a>{% endif %}
    </div>
    {% else %}
      {{ ui.empty('globe', 'No websites yet', 'Your administrator sets up websites in your hosting account. Once one is ready, it appears here.') }}
    {% endif %}
  {% else %}
  <div class="table-responsive">
    <table class="table lp-table lp-table--hover align-middle mb-0">
      <thead><tr><th>Website</th><th>Status</th><th class="d-none d-sm-table-cell">HTTPS</th><th class="d-none d-md-table-cell">Account</th><th class="d-none d-sm-table-cell">Server</th><th class="d-none d-lg-table-cell">PHP</th><th class="d-none d-lg-table-cell">Created</th><th class="text-end"><span class="visually-hidden">Open</span></th></tr></thead>
      <tbody>
      {% for row in rows %}
        {% set w = row.website %}
        <tr class="{{ w.status == 'deleted' ? 'lp-row-muted' : '' }}">
          <td>
            <div class="lp-person">
              <span class="lp-chip lp-chip--{{ _self.tone(w, row) }} lp-chip--sm">{{ ui.icon('globe') }}</span>
              <div class="min-w-0">
                <a class="lp-person__name stretched-link-row" href="{{ row.url }}">{{ w.domain }}</a>
                <div class="lp-person__meta">{% if row.aliases is empty %}<span class="font-monospace">web/{{ w.settings.document_root }}</span>{% else %}also {{ row.aliases|first }}{% if row.aliases|length > 1 %} and {{ row.aliases|length - 1 }} more{% endif %}{% endif %}</div>
              </div>
            </div>
          </td>
          <td>
            {% if row.account_suspended and w.status == 'active' %}<span class="lp-badge lp-badge--warning lp-badge--dot">Account suspended</span>{% else %}{{ ui.status_badge(w.status) }}{% endif %}
            {% if w.configState != 'ok' and w.status != 'deleted' %}<div class="small text-warning-emphasis mt-1 lp-cell-note">{{ ui.icon('alert') }} {{ w.configState == 'missing' ? 'File missing on the server' : 'Edited outside LPanel' }}</div>
            {% elseif w.lastError and not w.busy %}<div class="small text-danger-emphasis mt-1 text-truncate lp-cell-note" title="{{ w.lastError }}">{{ ui.icon('alert') }} Last {{ w.lastAction == 'update' ? 'change' : w.lastAction }} failed</div>{% endif %}
          </td>
          <td class="d-none d-sm-table-cell small">
            {%- set cert = row.certificate -%}
            {%- if cert is null -%}<span class="text-body-tertiary">—</span>
            {%- elseif cert.exists -%}
              <span class="lp-https lp-https--{{ cert.tone }}">{{ ui.icon(cert.state == 'expired' ? 'alert' : 'lock') }}{{ cert.state == 'active' ? 'Secured' : cert.label }}</span>
              <div class="text-body-tertiary text-nowrap">{{ cert.days_left < 0 ? 'expired' : 'until ' ~ cert.c.notAfter|date('j M Y') }}</div>
            {%- else -%}
              <span class="lp-https lp-https--{{ cert.tone }}">{{ ui.icon(cert.state == 'pending' ? 'clock' : 'shield-off') }}{{ cert.label }}</span>
            {%- endif -%}
          </td>
          <td class="d-none d-md-table-cell small">{% if row.account %}<span class="lp-cell-strong">{{ row.account.label }}</span><div class="text-body-tertiary font-monospace">{{ row.account.system_user }}</div>{% else %}<span class="text-body-tertiary">—</span>{% endif %}</td>
          <td class="d-none d-sm-table-cell small">{{ row.server ? row.server.name : '—' }}</td>
          <td class="d-none d-lg-table-cell small">{% if row.php %}<span class="font-monospace">{{ row.account and row.account.php_version ? row.account.php_version : 'On' }}</span>{% else %}<span class="text-body-tertiary">Static</span>{% endif %}</td>
          <td class="d-none d-lg-table-cell small text-nowrap">{{ ui.time(w.createdAt) }}</td>
          <td class="text-end"><span class="lp-row-chev">{{ ui.icon('chevron-right') }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
{% endblock %}
