{% extends "@Panel/shell.twig" %}

{% set badge = {delivered: 'ok', deferred: 'warn', failed: 'bad', rejected: 'bad', pending: 'info'} %}
{% macro detail(text) %}{{ text == 'mailbox' ? 'Mail.track_to_mailbox'|local : (text == 'local' ? 'Mail.track_to_local'|local : text) }}{% endmacro %}

{% block content %}
<div class="page-head">
    <div>
        <h1>{{ 'Mail.title'|local }}</h1>
        <p>{{ area == 'admin' ? 'Mail.track_lead_admin'|local : 'Mail.track_lead'|local }}</p>
    </div>
</div>
{% include '@Mail/tabs.twig' %}

<form class="card filter-bar" method="get" action="{{ action }}" role="search">
    <div class="field filter-bar-search">
        <label for="t-q">{{ 'Mail.track_search'|local }}</label>
        <div class="input-icon">{{ icon('search') }}<input class="input" type="search" id="t-q" name="q" value="{{ search }}" maxlength="254" placeholder="{{ 'Mail.track_search_placeholder'|local }}" autocapitalize="none" spellcheck="false"></div>
    </div>
    <div class="field">
        <label for="t-status">{{ 'Mail.track_status'|local }}</label>
        <select class="input" id="t-status" name="status">
            <option value="">{{ 'Mail.track_any'|local }}</option>
            {% for s in statuses %}<option value="{{ s }}"{% if s == status %} selected{% endif %}>{{ ('Mail.status_' ~ s)|local }}</option>{% endfor %}
        </select>
    </div>
    <div class="field">
        <label for="t-days">{{ 'Mail.track_days'|local }}</label>
        <select class="input" id="t-days" name="days">
            {% for d in day_options %}<option value="{{ d }}"{% if d == days %} selected{% endif %}>{{ 'Mail.track_last_days'|local({n: d}) }}</option>{% endfor %}
        </select>
    </div>
    <button class="btn btn-primary" type="submit">{{ icon('search') }}{{ 'Mail.track_show'|local }}</button>
</form>

{% if error %}
    <div class="alert alert-error">{{ icon('alert') }}<p>{{ error|local }}</p></div>
{% elseif result.deliveries is empty %}
    <div class="card"><div class="empty">{{ icon('mail') }}<h3>{{ 'Mail.track_none'|local }}</h3><p>{{ (search or status) ? 'Mail.track_none_filtered'|local : 'Mail.track_none_hint'|local({n: days}) }}</p></div></div>
{% else %}
<div class="card">
    <div class="table-wrap"><table class="table track-table">
        <thead><tr>
            <th>{{ 'Mail.track_when'|local }}</th>
            <th>{{ 'Mail.track_message'|local }}</th>
            <th>{{ 'Mail.track_status'|local }}</th>
            <th class="hide-sm">{{ 'Mail.track_detail'|local }}</th>
        </tr></thead>
        <tbody>
        {% for d in result.deliveries %}
            <tr>
                <td><div class="track-when"><span class="mono">{{ d.time|slice(5, 11) }}</span><span class="muted mono">UTC</span></div></td>
                <td class="track-route">
                    <div class="mono track-addr"><span class="muted track-label">{{ 'Mail.track_from'|local }}</span> {{ d.from ?: '<>' }}</div>
                    <div class="mono track-addr"><span class="muted track-label">{{ 'Mail.track_to'|local }}</span> {{ d.to ?: '—' }}</div>
                    {% if area == 'admin' and d.login %}<div class="domain-sub">{{ 'Mail.track_login'|local({login: d.login}) }}</div>{% endif %}
                    {% if d.detail %}<div class="domain-sub show-sm track-detail">{{ _self.detail(d.detail) }}</div>{% endif %}
                </td>
                <td><span class="badge {{ badge[d.status]|default('plain') }}">{{ ('Mail.status_' ~ d.status)|local }}</span></td>
                <td class="hide-sm track-detail">
                    {{ d.detail ? _self.detail(d.detail) : '—' }}
                    {% if d.id %}<div class="muted mono track-id">{{ d.id }}{% if d.size %} · {{ d.size|bytes }}{% endif %}</div>{% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% if result.more %}<div class="card-foot"><p class="hint" style="margin:0">{{ 'Mail.track_more'|local }}</p></div>{% endif %}
</div>
{% endif %}
{% endblock %}
