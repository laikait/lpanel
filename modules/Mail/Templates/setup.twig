{% extends "@Panel/shell.twig" %}

{% macro security(s) %}{{ s.security == 'ssl' ? 'SSL/TLS' : 'STARTTLS' }}{% endmacro %}

{% macro copy(value) %}<button class="btn btn-sm btn-ghost btn-icon setup-copy" type="button" data-copy="{{ value }}" data-copied="{{ 'Mail.copied'|local }}" aria-label="{{ 'Mail.copy_value'|local({value: value}) }}">{{ icon('copy') }}</button>{% endmacro %}

{% block content %}
<div class="page-head">
    <div>
        <a class="back-link" href="{{ back_url }}">{{ icon('chevron') }}{{ 'Mail.setup_back'|local }}</a>
        <h1 class="mono setup-title">{{ box.address }}</h1>
        <p>{{ 'Mail.setup_lead'|local }}</p>
    </div>
    <div class="page-actions">
        {% if active_account %}
        <form class="inline-form" method="post" action="{{ webmail_url }}" target="_blank">
            <input type="hidden" name="_token" value="{{ lp.token }}">
            <button class="btn btn-primary" type="submit">{{ icon('mail') }}{{ 'Mail.webmail_open'|local }}</button>
        </form>
        {% endif %}
    </div>
</div>

{% if not settings.own_certificate %}
    <div class="alert alert-info">{{ icon('info') }}<p>{{ 'Mail.setup_hostname_note'|local({domain: settings.domain, server: settings.server}) }}</p></div>
{% endif %}

<div class="grid grid-side">
    <section class="card">
        <div class="card-head"><div><h2>{{ 'Mail.setup_manual'|local }}</h2><p>{{ 'Mail.setup_manual_lead'|local }}</p></div></div>
        <div class="card-body">
            <dl class="setup-list">
                <div class="setup-item">
                    <dt>{{ 'Mail.setup_username'|local }}</dt>
                    <dd><span class="mono">{{ settings.username }}</span>{{ _self.copy(settings.username) }}</dd>
                </div>
                <div class="setup-item">
                    <dt>{{ 'Mail.setup_password'|local }}</dt>
                    <dd class="muted">{{ 'Mail.setup_password_value'|local }}</dd>
                </div>
                <div class="setup-item">
                    <dt>{{ 'Mail.setup_server'|local }}</dt>
                    <dd><span class="mono">{{ settings.server }}</span>{{ _self.copy(settings.server) }}</dd>
                </div>
            </dl>
        </div>
        <div class="table-wrap">
            <table class="table setup-ports">
                <thead><tr><th>{{ 'Mail.setup_protocol'|local }}</th><th>{{ 'Mail.setup_port'|local }}</th><th>{{ 'Mail.setup_security'|local }}</th></tr></thead>
                <tbody>
                    <tr><td><strong>IMAP</strong> <span class="muted hide-sm">· {{ 'Mail.setup_incoming'|local }}</span></td><td class="mono">{{ settings.imap.port }}</td><td>{{ _self.security(settings.imap) }} <span class="badge ok">{{ 'Mail.setup_best'|local }}</span></td></tr>
                    <tr><td><strong>IMAP</strong> <span class="muted hide-sm">· {{ 'Mail.setup_incoming'|local }}</span></td><td class="mono">{{ settings.imap_starttls.port }}</td><td>{{ _self.security(settings.imap_starttls) }}</td></tr>
                    <tr><td><strong>POP3</strong> <span class="muted hide-sm">· {{ 'Mail.setup_incoming'|local }}</span></td><td class="mono">{{ settings.pop3.port }}</td><td>{{ _self.security(settings.pop3) }}</td></tr>
                    <tr><td><strong>SMTP</strong> <span class="muted hide-sm">· {{ 'Mail.setup_outgoing'|local }}</span></td><td class="mono">{{ settings.smtp.port }}</td><td>{{ _self.security(settings.smtp) }} <span class="badge ok">{{ 'Mail.setup_best'|local }}</span></td></tr>
                    <tr><td><strong>SMTP</strong> <span class="muted hide-sm">· {{ 'Mail.setup_outgoing'|local }}</span></td><td class="mono">{{ settings.smtp_starttls.port }}</td><td>{{ _self.security(settings.smtp_starttls) }}</td></tr>
                </tbody>
            </table>
        </div>
        <div class="card-body mail-client-foot"><p class="hint" style="margin:0">{{ 'Mail.setup_smtp_login'|local }}</p></div>
    </section>

    <div class="stack">
        <section class="card">
            <div class="card-head"><div><h2>{{ 'Mail.setup_auto'|local }}</h2><p>{{ 'Mail.setup_auto_lead'|local }}</p></div></div>
            <div class="card-body">
                <ul class="setup-apps">
                    <li>{{ icon('check') }}<span>{{ 'Mail.setup_app_thunderbird'|local }}</span></li>
                    <li>{{ icon('check') }}<span>{{ 'Mail.setup_app_outlook'|local }}</span></li>
                    <li>{{ icon('check') }}<span>{{ 'Mail.setup_app_phones'|local }}</span></li>
                </ul>
            </div>
        </section>
        <section class="card">
            <div class="card-head"><div><h2>{{ 'Mail.setup_apple'|local }}</h2><p>{{ 'Mail.setup_apple_lead'|local }}</p></div></div>
            <div class="card-body">
                <a class="btn" href="{{ profile_url }}" download>{{ icon('phone') }}{{ 'Mail.setup_apple_download'|local }}</a>
            </div>
        </section>
        {% if webmail_address %}
        <section class="card">
            <div class="card-head"><div><h2>{{ 'Mail.webmail'|local }}</h2><p>{{ 'Mail.setup_webmail_lead'|local }}</p></div></div>
            <div class="card-body">
                <p class="setup-webmail"><span class="mono">{{ webmail_address }}</span>{{ _self.copy(webmail_address) }}</p>
            </div>
        </section>
        {% endif %}
    </div>
</div>
{% endblock %}
