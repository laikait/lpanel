{% extends "layout.twig" %}
{% import "macros/ui.twig" as ui %}

{% block title %}Audit log{% endblock %}
{% block crumb %}<span class="text-body-secondary">Administration</span>{{ ui.icon('chevron-right') }}<span>Audit log</span>{% endblock %}

{% block content %}
{{ ui.page_header('Audit log', 'Every sign-in, refusal and change, newest first. Kept for one year.') }}

<section class="card lp-card">
  <form method="get" action="{{ index_url }}" class="lp-toolbar">
    <div class="lp-segmented" role="group" aria-label="Activity type">
      {% for g in groups %}
        <a class="lp-segmented__item{{ g.active ? ' active' : '' }}" href="{{ g.url }}"{% if g.active %} aria-current="true"{% endif %}>{{ g.label }}</a>
      {% endfor %}
    </div>
    <input type="hidden" name="group" value="{{ group }}">
    <select class="form-select lp-toolbar__select ms-lg-auto" name="outcome" aria-label="Outcome" data-lp-autosubmit>
      <option value="">Any outcome</option>
      {% for o in outcomes %}<option value="{{ o }}"{{ outcome == o ? ' selected' : '' }}>{{ o|capitalize }}</option>{% endfor %}
    </select>
    <noscript><button class="btn btn-light" type="submit">Filter</button></noscript>
  </form>

  {% if events is empty %}
    {{ ui.empty('activity', paged ? 'No older events' : 'Nothing recorded yet', paged ? 'You have reached the start of the log.' : 'Events appear here as people sign in and make changes.') }}
  {% else %}
  <div class="table-responsive">
    <table class="table lp-table align-middle mb-0">
      <thead><tr><th>When</th><th>Who</th><th>What</th><th>Outcome</th><th>From</th><th class="text-end"><span class="visually-hidden">Details</span></th></tr></thead>
      <tbody>
      {% for e in events %}
        <tr>
          <td class="small text-nowrap">{{ ui.time(e.occurred_at) }}</td>
          <td>
            {% if e.actor %}
              <div class="lp-person lp-person--sm">
                {{ ui.avatar(e.actor.name, null, 'sm') }}
                <div class="min-w-0"><div class="lp-person__name">{{ e.actor.name }}</div>{% if e.actor.type == 'token' %}<div class="lp-person__meta">{{ ui.icon('key') }} via API token</div>{% endif %}</div>
              </div>
            {% else %}
              <span class="text-body-tertiary small">Not signed in</span>
            {% endif %}
          </td>
          <td>
            <div class="fw-medium">{{ e.label }}</div>
            <div class="small text-body-tertiary font-monospace">{{ e.action }}{% if e.metadata.login is defined %} · {{ e.metadata.login }}{% endif %}</div>
          </td>
          <td>{{ ui.outcome_badge(e.outcome) }}</td>
          <td class="small font-monospace text-body-secondary">{{ e.ip ?: '—' }}</td>
          <td class="text-end">
            {% if e.metadata|length > 0 or e.target %}
            <button class="btn btn-sm btn-link lp-btn-icon" type="button" data-bs-toggle="collapse" data-bs-target="#lp-ev-{{ e.id }}" aria-expanded="false" aria-controls="lp-ev-{{ e.id }}">{{ ui.icon('chevron-down') }}<span class="visually-hidden">Details</span></button>
            {% endif %}
          </td>
        </tr>
        {% if e.metadata|length > 0 or e.target %}
        <tr class="collapse lp-detail-row" id="lp-ev-{{ e.id }}">
          <td colspan="6">
            <dl class="lp-dl lp-dl--inline">
              {% if e.target %}<dt>Target</dt><dd><code>{{ e.target.type }}:{{ e.target.id }}</code></dd>{% endif %}
              {% for k, v in e.metadata %}<dt>{{ k|replace({'_': ' '})|capitalize }}</dt><dd><code>{{ v is iterable ? v|json_encode : v is same as(true) ? 'yes' : v is same as(false) ? 'no' : v }}</code></dd>{% endfor %}
              <dt>Event</dt><dd><code>#{{ e.id }}</code></dd>
            </dl>
          </td>
        </tr>
        {% endif %}
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% if paged or older_url %}
  <div class="lp-card__footer lp-pager">
    {% if paged %}<a class="btn btn-sm btn-light lp-btn-icon" href="{{ newest_url }}">{{ ui.icon('chevron-left') }}Newest</a>{% else %}<span></span>{% endif %}
    {% if older_url %}<a class="btn btn-sm btn-light lp-btn-icon" href="{{ older_url }}">Older{{ ui.icon('chevron-right') }}</a>{% endif %}
  </div>
  {% endif %}
  {% endif %}
</section>
{% endblock %}
