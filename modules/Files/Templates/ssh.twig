{% extends "@Panel/shell.twig" %}

{% macro err(errors, key) %}{% if errors[key] is defined %}<div class="error">{{ errors[key]|local }}</div>{% endif %}{% endmacro %}

{% macro copy(value, name) %}<button class="btn btn-sm btn-ghost setup-copy" type="button" data-copy="{{ value }}" data-copied="{{ 'Files.ftp_copied'|local }}" aria-label="{{ 'Files.ftp_copy_name'|local({name: name|default(value)}) }}">{{ icon('copy') }}</button>{% endmacro %}

{% block content %}
<div class="page-head">
    <div>
        <h1>{{ 'Files.ssh_title'|local }}</h1>
        <p>{{ ('Files.ssh_lead_' ~ access)|local }}</p>
    </div>
</div>

{% if generated %}
<section class="card ssh-generated" aria-labelledby="ssh-gen-title">
    <div class="card-head">
        <div><h2 id="ssh-gen-title">{{ 'Files.ssh_gen_title'|local({name: generated.name}) }}</h2><p>{{ 'Files.ssh_gen_lead'|local }}</p></div>
        <span class="badge warn">{{ 'Files.ssh_gen_once'|local }}</span>
    </div>
    <div class="card-body">
        <label class="sr-only" for="ssh-private">{{ 'Files.ssh_private_key'|local }}</label>
        <textarea class="input mono ssh-private" id="ssh-private" rows="9" readonly spellcheck="false" autocomplete="off">{{ generated.private }}</textarea>
        <div class="ssh-gen-actions">
            <button class="btn btn-primary" type="button" data-download="{{ generated.file }}" data-download-from="ssh-private">{{ icon('download') }}{{ 'Files.ssh_download'|local }}</button>
            <button class="btn" type="button" data-copy="{{ generated.private }}" data-copied="{{ 'Files.ftp_copied'|local }}">{{ icon('copy') }}{{ 'Files.ssh_copy_private'|local }}</button>
            {% if generated.fingerprint %}<span class="mono muted ssh-fp">{{ generated.fingerprint }}</span>{% endif %}
        </div>
        <ol class="ssh-steps">
            <li>{{ 'Files.ssh_gen_step_save'|local }} <code>~/.ssh/{{ generated.file }}</code></li>
            <li>{{ 'Files.ssh_gen_step_mode'|local }} <code>chmod 600 ~/.ssh/{{ generated.file }}</code></li>
            <li>{{ 'Files.ssh_gen_step_pass'|local }} <code>ssh-keygen -p -f ~/.ssh/{{ generated.file }}</code></li>
            <li>{{ 'Files.ssh_gen_step_use'|local }} <code>{{ access == 'sftp' ? 'sftp' : 'ssh' }} -i ~/.ssh/{{ generated.file }} {{ account.username }}@{{ host ?: 'server' }}</code></li>
        </ol>
        {% if generated.pending %}<div class="alert alert-info" style="margin-bottom:0">{{ icon('clock') }}<p>{{ 'Files.ssh_pending'|local }}</p></div>{% endif %}
    </div>
</section>
{% endif %}

{% if state and state.state == 'failed' %}
    <div class="alert alert-error">{{ icon('alert') }}<p><strong>{{ 'Files.ssh_last_failed'|local }}</strong><br><span class="mono">{{ state.error }}</span></p></div>
{% elseif state and state.state == 'pending' %}
    <div class="alert alert-info">{{ icon('clock') }}<p>{{ 'Files.ssh_pending_text'|local({since: state.changed_at|when}) }}</p></div>
{% endif %}
{% if account.status == 'suspended' %}
    <div class="alert alert-warning">{{ icon('pause') }}<p>{{ 'Files.ssh_suspended_text'|local }}</p></div>
{% endif %}

{% if access == 'none' %}
<div class="card"><div class="empty">{{ icon('terminal') }}<h3>{{ 'Files.ssh_no_access'|local }}</h3><p>{{ 'Files.ssh_no_access_hint'|local }}</p></div></div>
{% else %}

<div class="grid grid-3 stats-row" style="margin-bottom:20px">
    <div class="card stat">
        <span class="stat-icon">{{ icon('terminal') }}</span>
        <div><div class="stat-label">{{ 'Files.ssh_access'|local }}</div><div class="stat-value">{{ ('Files.ssh_access_' ~ access)|local }}</div><div class="stat-sub">{{ ('Files.ssh_access_sub_' ~ access)|local }}</div></div>
    </div>
    <div class="card stat">
        <span class="stat-icon">{{ icon('key') }}</span>
        <div><div class="stat-label">{{ 'Files.ssh_keys'|local }}</div><div class="stat-value">{{ keys|length }} / {{ max_keys }}</div><div class="stat-sub">{{ 'Files.ssh_keys_sub'|local }}</div></div>
    </div>
    <div class="card stat">
        <span class="stat-icon">{{ icon('shield') }}</span>
        <div><div class="stat-label">{{ 'Files.ssh_signin'|local }}</div><div class="stat-value">{{ 'Files.ssh_signin_value'|local }}</div><div class="stat-sub">{{ 'Files.ssh_signin_sub'|local }}</div></div>
    </div>
</div>

<div class="grid grid-side ssh-layout">
    <div class="stack">
        <div class="card">
            <div class="card-head"><div><h2>{{ 'Files.ssh_keys'|local }}</h2><p>{{ 'Files.ssh_keys_lead'|local }}</p></div></div>
            {% if keys is empty %}
                <div class="empty">{{ icon('key') }}<h3>{{ 'Files.ssh_none'|local }}</h3><p>{{ 'Files.ssh_none_hint'|local }}</p></div>
            {% else %}
            <div class="table-wrap"><table class="table">
                <thead><tr>
                    <th>{{ 'Files.ssh_key'|local }}</th>
                    <th class="hide-sm">{{ 'Files.ssh_type'|local }}</th>
                    <th class="hide-sm">{{ 'Files.ftp_made_at'|local }}</th>
                    <th style="text-align:end"><span class="sr-only">{{ 'Files.ftp_actions'|local }}</span></th>
                </tr></thead>
                <tbody>
                {% for k in keys %}
                    <tr>
                        <td>
                            <strong class="ssh-name">{{ k.name }}</strong>
                            <div class="domain-sub mono ssh-fp">{{ k.fingerprint }}</div>
                            <div class="domain-sub show-sm">{{ ('Files.ssh_type_' ~ (k.type|replace({'@openssh.com': '', '-': '_'})))|local }} · {{ k.bits }} bits</div>
                        </td>
                        <td class="hide-sm ssh-type"><span class="badge plain">{{ ('Files.ssh_type_' ~ (k.type|replace({'@openssh.com': '', '-': '_'})))|local }}</span> <span class="muted">{{ k.bits }}</span></td>
                        <td class="hide-sm ssh-made">{{ k.created_at ? k.created_at|when : '—' }}</td>
                        <td style="text-align:end;white-space:nowrap">
                            {{ _self.copy(k.line, k.name) }}
                            <form class="inline-form" method="post" action="{{ k.delete_url }}" data-confirm="{{ 'Files.ssh_confirm_delete'|local({name: k.name}) }}">
                                <input type="hidden" name="_token" value="{{ lp.token }}">
                                <button class="btn btn-sm btn-ghost" type="submit" aria-label="{{ 'Files.ssh_delete_name'|local({name: k.name}) }}">{{ icon('trash') }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table></div>
            {% endif %}
        </div>

        <section class="card">
            <div class="card-head"><div><h2>{{ 'Files.ssh_connect'|local }}</h2><p>{{ 'Files.ssh_connect_lead'|local }}</p></div></div>
            <div class="card-body">
                <dl class="setup-list">
                    <div class="setup-item">
                        <dt>{{ 'Files.ftp_host'|local }}</dt>
                        <dd>{% if host %}<span class="mono">{{ host }}</span>{{ _self.copy(host) }}{% else %}<span class="muted">{{ 'Files.ftp_host_unknown'|local }}</span>{% endif %}</dd>
                    </div>
                    <div class="setup-item">
                        <dt>{{ 'Files.ftp_port'|local }}</dt>
                        <dd class="mono">22</dd>
                    </div>
                    <div class="setup-item">
                        <dt>{{ 'Files.ftp_username'|local }}</dt>
                        <dd><span class="mono">{{ account.username }}</span>{{ _self.copy(account.username) }}</dd>
                    </div>
                    {% if access == 'jail' %}
                    <div class="setup-item">
                        <dt>{{ 'Files.ssh_shell'|local }}</dt>
                        <dd>{% set cmd = 'ssh ' ~ account.username ~ '@' ~ (host ?: 'server') %}<code class="ssh-cmd">{{ cmd }}</code>{{ _self.copy(cmd) }}</dd>
                    </div>
                    {% endif %}
                    <div class="setup-item">
                        <dt>SFTP</dt>
                        <dd>{% set cmd = 'sftp ' ~ account.username ~ '@' ~ (host ?: 'server') %}<code class="ssh-cmd">{{ cmd }}</code>{{ _self.copy(cmd) }}</dd>
                    </div>
                </dl>
            </div>
            <div class="card-body mail-client-foot"><p class="hint" style="margin:0">{{ 'Files.ssh_connect_hint'|local }}</p></div>
        </section>

        <section class="card">
            <div class="card-head"><div><h2>{{ 'Files.ssh_jail'|local }}</h2><p>{{ ('Files.ssh_jail_lead_' ~ access)|local }}</p></div></div>
            <div class="card-body">
                <ul class="ssh-facts">
                    <li>{{ icon('check') }}<span>{{ 'Files.ssh_fact_home'|local }}</span></li>
                    <li>{{ icon('check') }}<span>{{ 'Files.ssh_fact_others'|local }}</span></li>
                    {% if access == 'jail' %}
                    <li>{{ icon('check') }}<span>{{ 'Files.ssh_fact_tools'|local }}</span></li>
                    <li>{{ icon('check') }}<span>{{ 'Files.ssh_fact_db'|local }}</span></li>
                    {% endif %}
                    <li>{{ icon('x') }}<span>{{ 'Files.ssh_fact_forwarding'|local }}</span></li>
                    <li>{{ icon('x') }}<span>{{ 'Files.ssh_fact_root'|local }}</span></li>
                </ul>
            </div>
        </section>
    </div>

    <div class="stack">
        <form class="card" method="post" action="{{ store_url }}">
            <div class="card-head"><div><h2>{{ 'Files.ssh_add'|local }}</h2><p>{{ 'Files.ssh_add_lead'|local }}</p></div></div>
            <div class="card-body">
                <input type="hidden" name="_token" value="{{ lp.token }}">
                <div class="field">
                    <label for="ssh-key">{{ 'Files.ssh_public_key'|local }}</label>
                    <textarea class="input mono ssh-paste{% if errors.add_key is defined %} is-invalid{% endif %}" id="ssh-key" name="key" rows="4" spellcheck="false" autocomplete="off" autocapitalize="none" placeholder="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA… you@laptop" required>{{ old.key|default('') }}</textarea>
                    {{ _self.err(errors, 'add_key') }}
                    <div class="hint">{{ 'Files.ssh_public_key_hint'|local }}</div>
                </div>
                <div class="field">
                    <label for="ssh-name">{{ 'Files.ssh_name'|local }} <span class="muted">({{ 'Files.ssh_optional'|local }})</span></label>
                    <input class="input{% if errors.add_name is defined %} is-invalid{% endif %}" id="ssh-name" name="name" maxlength="64" autocomplete="off" value="{{ old.name|default('') }}" placeholder="laptop">
                    {{ _self.err(errors, 'add_name') }}
                    <div class="hint">{{ 'Files.ssh_name_hint'|local }}</div>
                </div>
            </div>
            <div class="card-foot"><button class="btn btn-primary" type="submit"{% if keys|length >= max_keys %} disabled{% endif %}>{{ icon('plus') }}{{ 'Files.ssh_add_button'|local }}</button></div>
        </form>

        <form class="card" method="post" action="{{ generate_url }}">
            <div class="card-head"><div><h2>{{ 'Files.ssh_generate'|local }}</h2><p>{{ 'Files.ssh_generate_lead'|local }}</p></div></div>
            <div class="card-body">
                <input type="hidden" name="_token" value="{{ lp.token }}">
                <div class="field" style="margin-bottom:0">
                    <label for="ssh-gen-name">{{ 'Files.ssh_name'|local }}</label>
                    <input class="input{% if errors.gen_name is defined %} is-invalid{% endif %}" id="ssh-gen-name" name="name" maxlength="64" autocomplete="off" value="{{ old.gen_name|default('') }}" placeholder="work-laptop" required>
                    {{ _self.err(errors, 'gen_name') }}{{ _self.err(errors, 'gen_key') }}
                </div>
            </div>
            <div class="card-foot"><button class="btn" type="submit"{% if keys|length >= max_keys %} disabled{% endif %}>{{ icon('key') }}{{ 'Files.ssh_generate_button'|local }}</button></div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}
