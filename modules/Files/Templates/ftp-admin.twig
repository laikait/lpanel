{% extends "@Panel/shell.twig" %}

{% macro err(errors, key) %}{% if errors[key] is defined %}<div class="error">{{ errors[key]|local }}</div>{% endif %}{% endmacro %}

{% block content %}
<div class="page-head">
    <div>
        <h1>{{ 'Files.ftp_title'|local }}</h1>
        <p>{{ 'Files.ftp_admin_lead'|local }}</p>
    </div>
</div>

{% if info is null %}
    <div class="alert alert-error">{{ icon('alert') }}<p>{{ 'Files.ftp_error_unreachable'|local }}</p></div>
{% elseif not info.enabled or not info.installed %}
    <div class="alert alert-warning">{{ icon('alert') }}<p>{{ 'Files.ftp_error_off'|local }}</p></div>
{% elseif not info.running %}
    <div class="alert alert-error">{{ icon('alert') }}<p>{{ 'Files.ftp_not_running'|local }}</p></div>
{% endif %}

<div class="grid grid-3 stats-row" style="margin-bottom:20px">
    <div class="card stat">
        <span class="stat-icon">{{ icon('server') }}</span>
        <div>
            <div class="stat-label">Pure-FTPd</div>
            <div class="stat-value">{% if info and info.running %}<span class="badge ok">{{ 'Files.ftp_running'|local }}</span>{% elseif info %}<span class="badge bad">{{ 'Files.ftp_stopped'|local }}</span>{% else %}—{% endif %}</div>
            <div class="stat-sub">{{ info and info.version ? 'Files.ftp_version'|local({v: info.version}) : '' }}</div>
        </div>
    </div>
    <div class="card stat">
        <span class="stat-icon">{{ icon('users') }}</span>
        <div><div class="stat-label">{{ 'Files.ftp_logins'|local }}</div><div class="stat-value">{{ logins|length }}</div><div class="stat-sub">{{ 'Files.ftp_logins_sub'|local }}</div></div>
    </div>
    <div class="card stat">
        <span class="stat-icon">{{ icon('activity') }}</span>
        <div><div class="stat-label">{{ 'Files.ftp_sessions'|local }}</div><div class="stat-value">{{ info and info.sessions_known ? sessions|length : '—' }}</div><div class="stat-sub">{{ 'Files.ftp_of_max'|local({n: settings.max_clients}) }}</div></div>
    </div>
</div>

<div class="grid grid-side" style="margin-bottom:20px">
    <section class="card">
        <div class="card-head"><div><h2>{{ 'Files.ftp_sessions'|local }}</h2><p>{{ 'Files.ftp_admin_sessions_lead'|local }}</p></div></div>
        {% if not info or not info.sessions_known %}
            <div class="card-body"><p class="muted" style="margin:0">{{ 'Files.ftp_sessions_unknown'|local }}</p></div>
        {% elseif sessions is empty %}
            <div class="empty">{{ icon('activity') }}<h3>{{ 'Files.ftp_no_sessions'|local }}</h3><p>{{ 'Files.ftp_admin_no_sessions_hint'|local }}</p></div>
        {% else %}
        <div class="table-wrap"><table class="table">
            <thead><tr>
                <th>{{ 'Files.ftp_login'|local }}</th>
                <th class="hide-sm">{{ 'Files.ftp_account_from'|local }}</th>
                <th>{{ 'Files.ftp_doing'|local }}</th>
                <th style="text-align:end"><span class="sr-only">{{ 'Files.ftp_actions'|local }}</span></th>
            </tr></thead>
            <tbody>
            {% for s in sessions %}
                <tr>
                    <td><strong class="mono ftp-login">{{ s.login|e|split('@')|join('<wbr>@')|raw }}</strong><div class="domain-sub show-sm mono">{{ s.account ?: '—' }} · {{ s.peer }}</div></td>
                    <td class="hide-sm"><span class="mono">{{ s.account ?: '—' }}</span><div class="domain-sub mono">{{ s.peer }}</div></td>
                    <td>{% include '@Files/ftp-doing.twig' %}</td>
                    <td style="text-align:end">
                        <form class="inline-form" method="post" action="{{ s.kill_url }}" data-confirm="{{ 'Files.ftp_confirm_kill'|local({name: s.login}) }}">
                            <input type="hidden" name="_token" value="{{ lp.token }}">
                            <button class="btn btn-sm btn-ghost" type="submit" aria-label="{{ 'Files.ftp_kill_name'|local({name: s.login}) }}">{{ icon('x') }}</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table></div>
        {% endif %}
    </section>

    <form class="card" method="post" action="{{ settings_url }}" data-show-from="tls">
        <div class="card-head"><div><h2>{{ 'Files.ftp_settings'|local }}</h2><p>{{ 'Files.ftp_settings_lead'|local }}</p></div></div>
        <div class="card-body">
            <input type="hidden" name="_token" value="{{ lp.token }}">
            <div class="field">
                <span class="label">{{ 'Files.ftp_encryption'|local }}</span>
                <div class="segmented" role="radiogroup" aria-label="{{ 'Files.ftp_encryption'|local }}">
                    {% for m in tls_modes %}
                        <label><input type="radio" name="tls" value="{{ m }}"{% if form.tls == m %} checked{% endif %}>{{ ('Files.ftp_tls_short_' ~ m)|local }}</label>
                    {% endfor %}
                </div>
                {{ _self.err(errors, 'tls') }}
                {% for m in tls_modes %}<div class="hint" data-show-for="{{ m }}">{{ ('Files.ftp_tls_hint_' ~ m)|local }}</div>{% endfor %}
            </div>
            <div class="field">
                <label for="pf">{{ 'Files.ftp_passive'|local }}</label>
                <div class="ftp-range">
                    <input class="input mono{% if errors.passive_from is defined %} is-invalid{% endif %}" id="pf" name="passive_from" inputmode="numeric" maxlength="5" value="{{ form.passive_from }}" aria-label="{{ 'Files.ftp_passive_from'|local }}">
                    <span aria-hidden="true">–</span>
                    <input class="input mono{% if errors.passive_to is defined %} is-invalid{% endif %}" name="passive_to" inputmode="numeric" maxlength="5" value="{{ form.passive_to }}" aria-label="{{ 'Files.ftp_passive_to'|local }}">
                </div>
                {{ _self.err(errors, 'passive_from') }}{{ _self.err(errors, 'passive_to') }}
                <div class="hint">{{ 'Files.ftp_passive_hint'|local }}</div>
            </div>
            <div class="field">
                <label for="pip">{{ 'Files.ftp_passive_ip'|local }} <span class="muted">{{ 'Files.ftp_optional'|local }}</span></label>
                <input class="input mono{% if errors.passive_ip is defined %} is-invalid{% endif %}" id="pip" name="passive_ip" maxlength="15" inputmode="decimal" autocomplete="off" value="{{ form.passive_ip }}" placeholder="203.0.113.10">
                {{ _self.err(errors, 'passive_ip') }}
                <div class="hint">{{ 'Files.ftp_passive_ip_hint'|local }}</div>
            </div>
            <div class="grid grid-2 ftp-limits">
                <div class="field">
                    <label for="mc">{{ 'Files.ftp_max_clients'|local }}</label>
                    <input class="input mono{% if errors.max_clients is defined %} is-invalid{% endif %}" id="mc" name="max_clients" inputmode="numeric" maxlength="5" value="{{ form.max_clients }}">
                    {{ _self.err(errors, 'max_clients') }}
                </div>
                <div class="field">
                    <label for="mp">{{ 'Files.ftp_max_per_ip'|local }}</label>
                    <input class="input mono{% if errors.max_per_ip is defined %} is-invalid{% endif %}" id="mp" name="max_per_ip" inputmode="numeric" maxlength="5" value="{{ form.max_per_ip }}">
                    {{ _self.err(errors, 'max_per_ip') }}
                </div>
            </div>
            <p class="hint" style="margin:0">{{ 'Files.ftp_restart_hint'|local }}</p>
        </div>
        <div class="card-foot"><button class="btn btn-primary" type="submit"{% if info is null or not info.enabled %} disabled{% endif %}>{{ 'Files.ftp_save_settings'|local }}</button></div>
    </form>
</div>

<section class="card">
    <div class="card-head"><div><h2>{{ 'Files.ftp_all_logins'|local }}</h2><p>{{ host ? 'Files.ftp_all_logins_lead'|local({host: host}) : 'Files.ftp_all_logins_lead_nohost'|local }}</p></div></div>
    {% if logins is empty %}
        <div class="empty">{{ icon('users') }}<h3>{{ 'Files.ftp_none'|local }}</h3><p>{{ 'Files.ftp_admin_none_hint'|local }}</p></div>
    {% else %}
    <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'Files.ftp_login'|local }}</th><th>{{ 'Files.ftp_account'|local }}</th><th class="hide-sm">{{ 'Files.ftp_folder'|local }}</th><th class="hide-sm">{{ 'Files.ftp_made_at'|local }}</th></tr></thead>
        <tbody>
        {% for u in logins %}
            <tr>
                <td><strong class="mono ftp-login">{{ u.login|e|split('@')|join('<wbr>@')|raw }}</strong><div class="domain-sub show-sm mono">/{{ u.folder }}</div></td>
                <td class="mono">{{ u.username }}</td>
                <td class="hide-sm mono">/{{ u.folder }}</td>
                <td class="hide-sm">{{ u.created_at ? u.created_at|when : '—' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% endif %}
</section>
{% endblock %}
